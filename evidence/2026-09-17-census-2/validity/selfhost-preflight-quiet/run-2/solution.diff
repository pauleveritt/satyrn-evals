+#!/usr/bin/env python3
+"""Certify the machine is quiet before a timed run: load, busy processes, decode rate.
+
+Three pure parsers read a snapshot each -- the load average, a `ps` listing,
+and the oMLX server log -- and `certificate` combines what they found into a
+single report. `main` wires the parsers to the real machine by default, but
+takes all four readings through keyword-only callables so a caller (the
+acceptance suite included) can inject readings without spawning anything.
+"""
+
+import argparse
+import json
+import os
+import re
+import subprocess
+from collections.abc import Callable, Iterable, Sequence
+from dataclasses import dataclass, field
+
+DEFAULT_CEILING = 0.5
+DEFAULT_CPU_FLOOR = 20.0
+DEFAULT_FLOOR_TOK_S = 30.0
+DEFAULT_LAST = 20
+IGNORE_PREFIXES = (
+    "/sbin/",
+    "/usr/sbin/",
+    "/usr/libexec/",
+    "/System/",
+    "/usr/local/bin/omlx-",
+    "omlx-",
+    "/Applications/oMLX.app/",
+)
+
+_LOG_RE = re.compile(
+    r"^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d{3} - omlx\.server - INFO - .* - "
+    r"Chat completion: model=(?P<model>[^,]+), (?P<tokens>\d+) tokens in "
+    r"(?P<seconds>[\d.]+)s \((?P<rate>[\d.]+) tok/s\), prompt: (?P<prompt>\d+),"
+)
+
+
+@dataclass(frozen=True, slots=True)
+class Process:
+    pid: int
+    comm: str
+    cpu: float
+
+
+@dataclass(frozen=True, slots=True)
+class Rate:
+    tok_s: float
+    completions: int
+    tokens: int
+    seconds: float
+
+
+@dataclass(frozen=True, slots=True)
+class Certificate:
+    problems: tuple[str, ...]
+    record: dict[str, object] = field(default_factory=dict)
+
+    def as_dict(self) -> dict[str, object]:
+        return {"problems": list(self.problems), "inputs": self.record}
+
+
+def load_problem(loadavg: tuple[float, float, float], cores: int, *, ceiling: float) -> str | None:
+    """Compare the one-minute load figure against `ceiling * cores`."""
+    one, _five, _fifteen = loadavg
+    threshold = ceiling * cores
+    if one <= threshold:
+        return None
+    return f"load {one:.1f} > {threshold:.1f} ({cores} cores)"
+
+
+def busy_processes(
+    ps_stdout: str, *, cpu_floor: float, ignore_prefixes: Sequence[str]
+) -> list[Process]:
+    """Parse `ps -axo pid,pcpu,comm` output into the processes above the floor."""
+    busy: list[Process] = []
+    for line in ps_stdout.splitlines():
+        fields = line.strip().split(maxsplit=2)
+        if len(fields) != 3:
+            continue
+        pid_text, cpu_text, comm = fields
+        try:
+            pid = int(pid_text)
+            cpu = float(cpu_text)
+        except ValueError:
+            continue
+        if not comm:
+            continue
+        if cpu <= cpu_floor:
+            continue
+        if any(comm.startswith(prefix) for prefix in ignore_prefixes):
+            continue
+        busy.append(Process(pid=pid, comm=comm, cpu=cpu))
+    return busy
+
+
+def decode_rate(log_lines: Iterable[str], *, model: str, last: int) -> Rate | None:
+    """Token-weighted decode rate over the last `last` completions for `model`."""
+    completions: list[tuple[int, float]] = []
+    for line in log_lines:
+        match = _LOG_RE.match(line)
+        if match is None or match.group("model") != model:
+            continue
+        completions.append((int(match.group("tokens")), float(match.group("seconds"))))
+    if len(completions) < last:
+        return None
+    window = completions[-last:]
+    tokens = sum(t for t, _ in window)
+    seconds = sum(s for _, s in window)
+    return Rate(tok_s=tokens / seconds, completions=last, tokens=tokens, seconds=seconds)
+
+
+def certificate(
+    load: str | None,
+    busy: Sequence[Process],
+    rate: Rate | None,
+    *,
+    floor_tok_s: float,
+    model: str,
+    last: int,
+) -> Certificate:
+    """Combine the three readings into the ordered problem list and its record."""
+    problems: list[str] = []
+    if load is not None:
+        problems.append(load)
+    for process in busy:
+        problems.append(f"busy: {process.comm} pid {process.pid} at {process.cpu:.1f}% cpu")
+    if rate is None:
+        problems.append(f"decode: fewer than {last} completions for {model}")
+    elif rate.tok_s < floor_tok_s:
+        problems.append(
+            f"decode {rate.tok_s:.1f} tok/s < {floor_tok_s:.1f} over last {rate.completions} completions"
+        )
+    record: dict[str, object] = {
+        "load": load,
+        "busy": [{"pid": p.pid, "comm": p.comm, "cpu": p.cpu} for p in busy],
+        "decode": None
+        if rate is None
+        else {
+            "tok_s": rate.tok_s,
+            "completions": rate.completions,
+            "tokens": rate.tokens,
+            "seconds": rate.seconds,
+        },
+        "floor_tok_s": floor_tok_s,
+        "model": model,
+        "last": last,
+    }
+    return Certificate(problems=tuple(problems), record=record)
+
+
+def _read_ps() -> str:
+    return subprocess.run(
+        ["ps", "-axo", "pid,pcpu,comm"], check=True, capture_output=True, text=True
+    ).stdout
+
+
+def _read_log() -> Iterable[str]:
+    log_path = os.environ.get("OMLX_SERVER_LOG", "")
+    if not log_path:
+        return []
+    with open(log_path, encoding="utf-8") as handle:
+        return handle.read().splitlines()
+
+
+def _cores() -> int:
+    return os.cpu_count() or 1
+
+
+def main(
+    argv: Sequence[str] | None = None,
+    *,
+    loadavg: Callable[[], tuple[float, float, float]] = os.getloadavg,
+    cores: Callable[[], int] = _cores,
+    read_ps: Callable[[], str] = _read_ps,
+    read_log: Callable[[], Iterable[str]] = _read_log,
+) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", required=True)
+    parser.add_argument("--ceiling", type=float, default=DEFAULT_CEILING)
+    parser.add_argument("--cpu-floor", type=float, default=DEFAULT_CPU_FLOOR)
+    parser.add_argument("--floor-tok-s", type=float, default=DEFAULT_FLOOR_TOK_S)
+    parser.add_argument("--last", type=int, default=DEFAULT_LAST)
+    args = parser.parse_args(argv)
+
+    load = load_problem(loadavg(), cores(), ceiling=args.ceiling)
+    busy = busy_processes(read_ps(), cpu_floor=args.cpu_floor, ignore_prefixes=IGNORE_PREFIXES)
+    rate = decode_rate(read_log(), model=args.model, last=args.last)
+    cert = certificate(
+        load,
+        busy,
+        rate,
+        floor_tok_s=args.floor_tok_s,
+        model=args.model,
+        last=args.last,
+    )
+    print(json.dumps(cert.as_dict()))
+    return 0 if not cert.problems else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
