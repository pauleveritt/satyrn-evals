@@ -0,0 +1,256 @@
+"""The machine-quiet preflight: idle load, no busy measurement-shaped
+process, and a decode rate that is not throttled.
+
+Drives `preflight_quiet.main` through its injected callables rather than a
+subprocess (default tier, no subprocess rule). Each parser has a known-good
+and a known-bad case, each threshold is checked at its edge and just across
+it, the ignore list is checked both ways, the decode rate is checked as
+token-weighted rather than a per-completion mean, and both CLI exit codes
+are exercised.
+"""
+
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "scripts"))
+
+from preflight_quiet import (  # noqa: E402, I001
+    IGNORE_PREFIXES,
+    Process,
+    Rate,
+    busy_processes,
+    certificate,
+    decode_rate,
+    load_problem,
+    main,
+)
+
+MODEL = "Ornith-1.5-9B-MLX-8bit"
+
+
+def _completion_line(ts: str, tokens: int, seconds: float, *, model: str = MODEL) -> str:
+    rate = tokens / seconds
+    return (
+        f"{ts} - omlx.server - INFO - [-] - Chat completion: "
+        f"model={model}, {tokens} tokens in {seconds:.2f}s ({rate:.1f} tok/s), "
+        "prompt: 5000, finish_reason=stop, max_tokens=16000, request_max_tokens=16000"
+    )
+
+
+# --- load_problem ------------------------------------------------------
+
+
+def test_load_problem_is_none_when_quiet() -> None:
+    assert load_problem((1.0, 1.0, 1.0), 8, ceiling=0.5) is None
+
+
+def test_load_problem_message_when_loud() -> None:
+    assert load_problem((9.5, 1.0, 1.0), 8, ceiling=0.5) == "load 9.5 > 4.0 (8 cores)"
+
+
+def test_load_exactly_at_the_ceiling_is_quiet() -> None:
+    assert load_problem((4.0, 0.0, 0.0), 8, ceiling=0.5) is None
+
+
+def test_load_just_above_the_ceiling_is_a_problem() -> None:
+    assert load_problem((4.1, 0.0, 0.0), 8, ceiling=0.5) == "load 4.1 > 4.0 (8 cores)"
+
+
+def test_load_problem_ignores_five_and_fifteen_minute_figures() -> None:
+    # A quiet one-minute figure is quiet regardless of the trailing averages.
+    assert load_problem((1.0, 99.0, 99.0), 8, ceiling=0.5) is None
+
+
+# --- busy_processes ------------------------------------------------------
+
+PS_HEADER = "  PID  %CPU COMM"
+
+
+def test_busy_processes_finds_a_busy_command() -> None:
+    ps_stdout = "\n".join([PS_HEADER, "101 55.0 /usr/local/bin/omlx-server"])
+    found = busy_processes(ps_stdout, cpu_floor=20.0, ignore_prefixes=())
+    assert found == [Process(pid=101, comm="/usr/local/bin/omlx-server", cpu=55.0)]
+
+
+def test_busy_processes_skips_the_header_and_blank_lines() -> None:
+    ps_stdout = "\n".join([PS_HEADER, "", "   "])
+    assert busy_processes(ps_stdout, cpu_floor=20.0, ignore_prefixes=()) == []
+
+
+def test_busy_processes_skips_a_line_with_a_non_float_cpu() -> None:
+    ps_stdout = "\n".join([PS_HEADER, "101 busy /usr/local/bin/thing"])
+    assert busy_processes(ps_stdout, cpu_floor=20.0, ignore_prefixes=()) == []
+
+
+def test_cpu_exactly_at_the_floor_is_quiet() -> None:
+    ps_stdout = "\n".join([PS_HEADER, "101 20.0 /usr/local/bin/thing"])
+    assert busy_processes(ps_stdout, cpu_floor=20.0, ignore_prefixes=()) == []
+
+
+def test_cpu_just_above_the_floor_is_busy() -> None:
+    ps_stdout = "\n".join([PS_HEADER, "101 20.1 /usr/local/bin/thing"])
+    found = busy_processes(ps_stdout, cpu_floor=20.0, ignore_prefixes=())
+    assert found == [Process(pid=101, comm="/usr/local/bin/thing", cpu=20.1)]
+
+
+def test_ignore_list_excludes_a_matching_prefix() -> None:
+    ps_stdout = "\n".join([PS_HEADER, "101 90.0 /sbin/launchd"])
+    assert busy_processes(ps_stdout, cpu_floor=20.0, ignore_prefixes=IGNORE_PREFIXES) == []
+
+
+def test_ignore_list_leaves_a_non_matching_prefix_busy() -> None:
+    ps_stdout = "\n".join([PS_HEADER, "101 90.0 /usr/local/bin/some-other-thing"])
+    found = busy_processes(ps_stdout, cpu_floor=20.0, ignore_prefixes=IGNORE_PREFIXES)
+    assert found == [Process(pid=101, comm="/usr/local/bin/some-other-thing", cpu=90.0)]
+
+
+def test_busy_processes_preserves_snapshot_order() -> None:
+    ps_stdout = "\n".join(
+        [
+            PS_HEADER,
+            "101 90.0 /usr/local/bin/second-looking-first",
+            "50 50.0 /usr/local/bin/first-in-snapshot",
+        ]
+    )
+    found = busy_processes(ps_stdout, cpu_floor=20.0, ignore_prefixes=())
+    assert [p.pid for p in found] == [101, 50]
+
+
+# --- decode_rate ------------------------------------------------------
+
+
+def test_decode_rate_parses_a_known_good_completion_line() -> None:
+    lines = [_completion_line("2026-09-17 21:14:02,004", 900, 10.0)] * 20
+    rate = decode_rate(lines, model=MODEL, last=20)
+    assert rate == Rate(tok_s=90.0, completions=20, tokens=18000, seconds=200.0)
+
+
+def test_decode_rate_ignores_a_bare_fragment_without_the_log_stamp() -> None:
+    bad = "Chat completion: model=" + MODEL + ", 900 tokens in 10.00s (90.0 tok/s), prompt: 5000,"
+    lines = [_completion_line("2026-09-17 21:14:02,004", 900, 10.0)] * 19 + [bad]
+    assert decode_rate(lines, model=MODEL, last=20) is None
+
+
+def test_decode_rate_ignores_lines_for_another_model() -> None:
+    lines = [_completion_line("2026-09-17 21:14:02,004", 900, 10.0, model="Other-Model")] * 20
+    assert decode_rate(lines, model=MODEL, last=20) is None
+
+
+def test_decode_rate_is_none_with_fewer_than_last_completions() -> None:
+    lines = [_completion_line("2026-09-17 21:14:02,004", 900, 10.0)] * 19
+    assert decode_rate(lines, model=MODEL, last=20) is None
+
+
+def test_decode_rate_is_token_weighted_not_the_per_completion_mean() -> None:
+    # 32 tokens in 1s (32 tok/s) and 8000 tokens in 100s (80 tok/s): the
+    # mean of the two per-completion rates is 56.0, but the token-weighted
+    # rate is (32 + 8000) / (1 + 100) tok/s.
+    lines = [
+        _completion_line("2026-09-17 21:14:00,000", 32, 1.0),
+        _completion_line("2026-09-17 21:14:02,000", 8000, 100.0),
+    ]
+    rate = decode_rate(lines, model=MODEL, last=2)
+    assert rate == Rate(tok_s=8032 / 101, completions=2, tokens=8032, seconds=101.0)
+
+
+def test_decode_rate_keeps_only_the_last_n_completions() -> None:
+    stale = [_completion_line("2026-09-17 21:00:00,000", 1, 1.0)] * 5
+    fresh = [_completion_line("2026-09-17 21:14:02,004", 900, 10.0)] * 20
+    rate = decode_rate(stale + fresh, model=MODEL, last=20)
+    assert rate == Rate(tok_s=90.0, completions=20, tokens=18000, seconds=200.0)
+
+
+def test_rate_exactly_at_the_floor_is_quiet() -> None:
+    rate = Rate(tok_s=30.0, completions=20, tokens=600, seconds=20.0)
+    cert = certificate(None, (), rate, floor_tok_s=30.0, model=MODEL, last=20)
+    assert cert.problems == ()
+
+
+def test_rate_just_below_the_floor_is_a_problem() -> None:
+    rate = Rate(tok_s=29.9, completions=20, tokens=598, seconds=20.0)
+    cert = certificate(None, (), rate, floor_tok_s=30.0, model=MODEL, last=20)
+    assert cert.problems == ("decode 29.9 tok/s < 30.0 over last 20 completions",)
+
+
+# --- certificate ------------------------------------------------------
+
+
+def test_certificate_reports_fewer_than_n_when_rate_is_none() -> None:
+    cert = certificate(None, (), None, floor_tok_s=30.0, model=MODEL, last=20)
+    assert cert.problems == (f"decode: fewer than 20 completions for {MODEL}",)
+
+
+def test_certificate_orders_load_then_busy_then_decode() -> None:
+    busy = (Process(pid=101, comm="/usr/local/bin/thing", cpu=55.0),)
+    cert = certificate("load 9.5 > 4.0 (8 cores)", busy, None, floor_tok_s=30.0, model=MODEL, last=20)
+    assert cert.problems == (
+        "load 9.5 > 4.0 (8 cores)",
+        "busy: /usr/local/bin/thing pid 101 at 55.0% cpu",
+        f"decode: fewer than 20 completions for {MODEL}",
+    )
+
+
+def test_certificate_as_dict_json_shape_round_trips() -> None:
+    busy = (Process(pid=101, comm="/usr/local/bin/thing", cpu=55.0),)
+    rate = Rate(tok_s=29.9, completions=20, tokens=598, seconds=20.0)
+    cert = certificate("load 9.5 > 4.0 (8 cores)", busy, rate, floor_tok_s=30.0, model=MODEL, last=20)
+    payload = json.loads(json.dumps(cert.as_dict()))
+    assert payload == {
+        "problems": [
+            "load 9.5 > 4.0 (8 cores)",
+            "busy: /usr/local/bin/thing pid 101 at 55.0% cpu",
+            "decode 29.9 tok/s < 30.0 over last 20 completions",
+        ],
+        "inputs": {
+            "load": "load 9.5 > 4.0 (8 cores)",
+            "busy": [{"pid": 101, "comm": "/usr/local/bin/thing", "cpu": 55.0}],
+            "decode": {"tok_s": 29.9, "completions": 20, "tokens": 598, "seconds": 20.0},
+            "floor_tok_s": 30.0,
+            "model": MODEL,
+            "last": 20,
+        },
+    }
+
+
+def test_certificate_as_dict_decode_is_null_when_rate_is_none() -> None:
+    cert = certificate(None, (), None, floor_tok_s=30.0, model=MODEL, last=20)
+    assert cert.as_dict()["inputs"]["decode"] is None
+
+
+# --- main / CLI ------------------------------------------------------
+
+
+def _quiet_reader() -> tuple:
+    lines = [_completion_line("2026-09-17 21:14:02,004", 900, 10.0)] * 20
+    ps_stdout = "\n".join([PS_HEADER, "101 5.0 /usr/local/bin/idle-thing"])
+    return (1.0, 1.0, 1.0), 8, ps_stdout, lines
+
+
+def test_main_returns_zero_and_prints_the_certificate_when_quiet(capsys) -> None:
+    loadavg_value, cores_value, ps_stdout, log_lines = _quiet_reader()
+    code = main(
+        ["--model", MODEL],
+        loadavg=lambda: loadavg_value,
+        cores=lambda: cores_value,
+        read_ps=lambda: ps_stdout,
+        read_log=lambda: log_lines,
+    )
+    assert code == 0
+    payload = json.loads(capsys.readouterr().out)
+    assert payload["problems"] == []
+
+
+def test_main_returns_one_when_the_machine_is_loud(capsys) -> None:
+    ps_stdout = "\n".join([PS_HEADER, "101 5.0 /usr/local/bin/idle-thing"])
+    log_lines = [_completion_line("2026-09-17 21:14:02,004", 900, 10.0)] * 20
+    code = main(
+        ["--model", MODEL],
+        loadavg=lambda: (9.5, 1.0, 1.0),
+        cores=lambda: 8,
+        read_ps=lambda: ps_stdout,
+        read_log=lambda: log_lines,
+    )
+    assert code == 1
+    payload = json.loads(capsys.readouterr().out)
+    assert payload["problems"] == ["load 9.5 > 4.0 (8 cores)"]
