+#!/usr/bin/env python3
+"""Certify the machine is quiet enough to start a batch on.
+
+Instrument, not production code. Three things sit between a batch and a
+trustworthy measurement: the one-minute load average against the core
+count, any measurement-shaped process already busy on the CPU, and the
+oMLX server's own decode rate over its most recent completions. Each is
+read through an injected callable -- `os.getloadavg`, the core count, a
+`ps -axo pid,pcpu,comm` subprocess and the server log -- so the acceptance
+suite can drive a quiet machine and a loud one from the same process,
+without spawning anything.
+
+A quiet machine prints an empty `problems` list and exits 0; a loud one
+names every problem it found and exits 1. The certificate is JSON on
+stdout and nothing else, so it can be piped straight into a batch record.
+"""
+
+import argparse
+import json
+import os
+import re
+import subprocess
+import sys
+from collections.abc import Iterable, Sequence
+from dataclasses import dataclass
+from pathlib import Path
+
+DEFAULT_CEILING = 0.5
+DEFAULT_CPU_FLOOR = 20.0
+DEFAULT_FLOOR_TOK_S = 30.0
+DEFAULT_LAST = 20
+
+#: Commands that are always the machine's own idle furniture, never a
+#: measurement in progress. Checked with `str.startswith`, so a prefix
+#: naming a directory needs its trailing slash.
+IGNORE_PREFIXES = (
+    "/sbin/",
+    "/usr/sbin/",
+    "/usr/libexec/",
+    "/System/",
+    "/usr/local/bin/omlx-",
+    "omlx-",
+    "/Applications/oMLX.app/",
+)
+
+#: Confirmed against a live install on 2026-09-14 (`scripts/speed_probe.py`).
+DEFAULT_SERVER_LOG = Path.home() / ".omlx" / "logs" / "server.log"
+
+
+@dataclass(frozen=True, slots=True)
+class Process:
+    pid: int
+    comm: str
+    cpu: float
+
+
+@dataclass(frozen=True, slots=True)
+class Rate:
+    tok_s: float
+    completions: int
+    tokens: int
+    seconds: float
+
+
+@dataclass(frozen=True, slots=True)
+class Certificate:
+    """`problems` is empty exactly when the machine is quiet; `record` is
+    every input the certificate was built from."""
+
+    problems: tuple[str, ...]
+    record: dict[str, object]
+
+    def as_dict(self) -> dict[str, object]:
+        return {"problems": list(self.problems), "inputs": self.record}
+
+
+def load_problem(loadavg: tuple[float, float, float], cores: int, *, ceiling: float) -> str | None:
+    """Compare only the one-minute figure against ``ceiling * cores``.
+
+    A load at or below that product is quiet; the ceiling itself is quiet.
+    """
+    one, _five, _fifteen = loadavg
+    threshold = ceiling * cores
+    if one <= threshold:
+        return None
+    return f"load {one:.1f} > {threshold:.1f} ({cores} cores)"
+
+
+def busy_processes(ps_stdout: str, *, cpu_floor: float, ignore_prefixes: Sequence[str]) -> list[Process]:
+    """Parse ``ps -axo pid,pcpu,comm`` output.
+
+    Each line is split into at most three fields and kept only when they
+    are an integer pid, a float cpu and a non-empty command -- which
+    disposes of the header and any blank or malformed line without a
+    special case for either. A process is busy when its cpu is strictly
+    greater than ``cpu_floor`` and its command starts with none of
+    ``ignore_prefixes``. Returned in snapshot order.
+    """
+    prefixes = tuple(ignore_prefixes)
+    busy: list[Process] = []
+    for line in ps_stdout.splitlines():
+        fields = line.split(maxsplit=2)
+        if len(fields) != 3:
+            continue
+        pid_field, cpu_field, comm = fields
+        if not comm:
+            continue
+        try:
+            pid = int(pid_field)
+            cpu = float(cpu_field)
+        except ValueError:
+            continue
+        if cpu <= cpu_floor or comm.startswith(prefixes):
+            continue
+        busy.append(Process(pid=pid, comm=comm, cpu=cpu))
+    return busy
+
+
+#: One oMLX server-log completion line, e.g.:
+#: ``2026-09-17 21:14:02,004 - omlx.server - INFO - [-] - Chat completion:
+#: model=Ornith-1.5-9B-MLX-8bit, 900 tokens in 10.00s (90.0 tok/s), prompt:
+#: 5000, finish_reason=stop, max_tokens=16000, request_max_tokens=16000``.
+#: The timestamped ``omlx.server - INFO`` prefix and the whole ``Chat
+#: completion: model=..., N tokens in Xs (R tok/s), prompt: P,`` shape are
+#: both required: a bare fragment or another logger's line is not a match.
+_COMPLETION = re.compile(
+    r"^\S+ \S+ - omlx\.server - INFO - .*Chat completion: "
+    r"model=(?P<model>[^,]+), (?P<tokens>\d+) tokens in (?P<seconds>[\d.]+)s "
+    r"\([\d.]+ tok/s\), prompt: \d+,"
+)
+
+
+def decode_rate(log_lines: Iterable[str], *, model: str, last: int) -> Rate | None:
+    """The token-weighted decode rate over the last ``last`` completions for
+    ``model``, in log order.
+
+    Returns ``None`` when fewer than ``last`` completions were found.
+    ``tok_s`` is ``sum(tokens) / sum(seconds)`` -- never the mean of the
+    per-completion rates -- so a 32-token completion does not weigh the
+    same as an 8,000-token one.
+    """
+    tokens: list[int] = []
+    seconds: list[float] = []
+    for line in log_lines:
+        match = _COMPLETION.match(line)
+        if match is None or match["model"] != model:
+            continue
+        tokens.append(int(match["tokens"]))
+        seconds.append(float(match["seconds"]))
+    if len(tokens) < last:
+        return None
+    window_tokens = tokens[-last:]
+    window_seconds = seconds[-last:]
+    total_tokens = sum(window_tokens)
+    total_seconds = sum(window_seconds)
+    return Rate(tok_s=total_tokens / total_seconds, completions=last, tokens=total_tokens, seconds=total_seconds)
+
+
+def certificate(
+    load: str | None,
+    busy: Sequence[Process],
+    rate: Rate | None,
+    *,
+    floor_tok_s: float,
+    model: str,
+    last: int,
+) -> Certificate:
+    """Build the certificate: the load message (if any), then one ``busy:``
+    line per busy process, then the decode problem (if any) -- ``None``
+    when the machine is quiet on that axis.
+
+    The two decode problems are exclusive: fewer than ``last`` completions
+    were found, or the rate is strictly below ``floor_tok_s``. A rate
+    exactly at the floor is quiet.
+    """
+    problems: list[str] = []
+    if load is not None:
+        problems.append(load)
+    for process in busy:
+        problems.append(f"busy: {process.comm} pid {process.pid} at {process.cpu:.1f}% cpu")
+    if rate is None:
+        problems.append(f"decode: fewer than {last} completions for {model}")
+    elif rate.tok_s < floor_tok_s:
+        problems.append(
+            f"decode {rate.tok_s:.1f} tok/s < {floor_tok_s:.1f} over last {rate.completions} completions"
+        )
+    record: dict[str, object] = {
+        "load": load,
+        "busy": [{"pid": p.pid, "comm": p.comm, "cpu": p.cpu} for p in busy],
+        "decode": (
+            None
+            if rate is None
+            else {
+                "tok_s": rate.tok_s,
+                "completions": rate.completions,
+                "tokens": rate.tokens,
+                "seconds": rate.seconds,
+            }
+        ),
+        "floor_tok_s": floor_tok_s,
+        "model": model,
+        "last": last,
+    }
+    return Certificate(problems=tuple(problems), record=record)
+
+
+def _read_ps() -> str:
+    return subprocess.run(
+        ["ps", "-axo", "pid,pcpu,comm"], capture_output=True, text=True, check=True
+    ).stdout
+
+
+def _read_log() -> list[str]:
+    if not DEFAULT_SERVER_LOG.exists():
+        return []
+    return DEFAULT_SERVER_LOG.read_text(encoding="utf-8").splitlines()
+
+
+def _cores() -> int:
+    return os.cpu_count() or 1
+
+
+def main(
+    argv: Sequence[str] | None = None,
+    *,
+    loadavg=os.getloadavg,
+    cores=_cores,
+    read_ps=_read_ps,
+    read_log=_read_log,
+) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", required=True, help="the model decode_rate keeps completions for")
+    parser.add_argument("--ceiling", type=float, default=DEFAULT_CEILING)
+    parser.add_argument("--cpu-floor", type=float, default=DEFAULT_CPU_FLOOR)
+    parser.add_argument("--floor-tok-s", type=float, default=DEFAULT_FLOOR_TOK_S)
+    parser.add_argument("--last", type=int, default=DEFAULT_LAST)
+    args = parser.parse_args(argv)
+
+    load = load_problem(loadavg(), cores(), ceiling=args.ceiling)
+    busy = busy_processes(read_ps(), cpu_floor=args.cpu_floor, ignore_prefixes=IGNORE_PREFIXES)
+    rate = decode_rate(read_log(), model=args.model, last=args.last)
+    cert = certificate(load, busy, rate, floor_tok_s=args.floor_tok_s, model=args.model, last=args.last)
+    print(json.dumps(cert.as_dict()))
+    return 0 if not cert.problems else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
