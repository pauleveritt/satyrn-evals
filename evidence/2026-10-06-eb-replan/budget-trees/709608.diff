+"""The run record: the bounded, gate-able description of one planned run.
+
+A run record is a single JSON object. Every field is required and typed, and
+`load_run_record` refuses the file before it is ever trusted by `gate`. The
+gate then enforces the cadence (per `mode`) and, when a run leans on a
+`previous_result`, that the referenced result is already committed. Both the
+loader and the gate raise `RunRecordError` -- a `UsageError`, so the CLI's
+existing usage-error path (exit 2) handles it without guessing.
+
+The record is deliberately free of any filesystem, subprocess, or model: it
+is pure data, and `gate` is pure data in, pure data out, told by the caller
+whether the previous result is committed so it can stay that way.
+"""
+
+import json
+import re
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Literal
+
+from satyrn_evals.errors import UsageError
+
+type Mode = Literal["attended", "batch"]
+type Condition = Literal["cold", "warm"]
+
+# Every field, in the exact order the record schema records. The order is the
+# order the loader checks presence and type, then the order the value checks
+# run; the acceptance suite matches messages by substring, so the order only
+# matters when a record carries more than one fault.
+_VERSION = "version"
+_TASK = "task"
+_TASK_TREE_SHA256 = "task_tree_sha256"
+_ARM = "arm"
+_MODEL = "model"
+_CONDITION = "condition"
+_N = "n"
+_MODE = "mode"
+_MAX_MINUTES = "max_minutes"
+_STOP_RULE = "stop_rule"
+_DECISION_RULE = "decision_rule"
+_PREVIOUS_RESULT = "previous_result"
+
+_INT_FIELDS = (_VERSION, _N, _MAX_MINUTES)
+_STR_FIELDS = (
+    _TASK,
+    _TASK_TREE_SHA256,
+    _ARM,
+    _MODEL,
+    _CONDITION,
+    _MODE,
+    _STOP_RULE,
+    _DECISION_RULE,
+)
+
+# 64 lowercase hex characters: a tree SHA, not a display hash.
+_HEX_RE = re.compile(r"^[0-9a-f]{64}$")
+
+
+class RunRecordError(UsageError):
+    """The record file could not be read, parsed, or shaped, or an already
+    loaded record violates the cadence. Exit 2 via the CLI's usage path."""
+
+
+@dataclass(frozen=True, slots=True)
+class RunRecord:
+    version: int
+    task: str
+    task_tree_sha256: str
+    arm: str
+    model: str
+    condition: str
+    n: int
+    mode: str
+    max_minutes: int
+    stop_rule: str
+    decision_rule: str
+    previous_result: str | None
+
+    @staticmethod
+    def _is_int(value: object) -> bool:
+        # bool is an int subclass; a JSON `true` is not a count.
+        return isinstance(value, int) and not isinstance(value, bool)
+
+    @classmethod
+    def _load(cls, path: Path) -> "RunRecord":
+        try:
+            raw = path.read_text(encoding="utf-8")
+        except OSError as exc:
+            raise RunRecordError(f"cannot read {path}: {exc}") from exc
+        try:
+            data = json.loads(raw)
+        except json.JSONDecodeError as exc:
+            raise RunRecordError(f"{path}: {exc}") from exc
+        if not isinstance(data, dict):
+            raise RunRecordError(
+                f"{path}: the record is not a JSON object"
+            )
+
+        values: dict[str, object] = {}
+        for field in _STR_FIELDS:
+            if field not in data:
+                raise RunRecordError(f"missing field: {field}")
+            values[field] = data[field]
+            if not isinstance(values[field], str):
+                raise RunRecordError(f"{field} has the wrong type")
+        for field in _INT_FIELDS:
+            if field not in data:
+                raise RunRecordError(f"missing field: {field}")
+            values[field] = data[field]
+            if not RunRecord._is_int(values[field]):
+                raise RunRecordError(f"{field} has the wrong type")
+
+        # Value checks run after every type check, in schema order, so a
+        # record that is well-typed but out of cadence is refused exactly
+        # once, by the first bad value below.
+        condition = values[_CONDITION]
+        if condition not in ("cold", "warm"):
+            raise RunRecordError(f"{_CONDITION} must be cold or warm")
+        mode = values[_MODE]
+        if mode not in ("attended", "batch"):
+            raise RunRecordError("mode must be attended or batch")
+        if not _HEX_RE.match(values[_TASK_TREE_SHA256]):
+            raise RunRecordError(
+                f"{_TASK_TREE_SHA256} is not 64 lowercase hex characters"
+            )
+        if not values[_STOP_RULE].strip():
+            raise RunRecordError(f"{_STOP_RULE} is empty")
+        if not values[_DECISION_RULE].strip():
+            raise RunRecordError(f"{_DECISION_RULE} is empty")
+
+        previous_result = data[_PREVIOUS_RESULT]
+        if previous_result is not None and not isinstance(previous_result, str):
+            raise RunRecordError("previous_result has the wrong type")
+
+        return cls(
+            version=int(values[_VERSION]),
+            task=values[_TASK],
+            task_tree_sha256=values[_TASK_TREE_SHA256],
+            arm=values[_ARM],
+            model=values[_MODEL],
+            condition=condition,
+            n=int(values[_N]),
+            mode=mode,
+            max_minutes=int(values[_MAX_MINUTES]),
+            stop_rule=values[_STOP_RULE],
+            decision_rule=values[_DECISION_RULE],
+            previous_result=None
+            if data[_PREVIOUS_RESULT] is None else data[_PREVIOUS_RESULT],
+        )
+
+
+def load_run_record(path: Path) -> RunRecord:
+    """Read and validate a run record at `path`.
+
+    Refuses (raising `RunRecordError`) on a file that cannot be read, JSON
+    that is malformed, a document that is not a JSON object, a field that is
+    missing or the wrong type, and a value that breaks a rule below:
+    `condition` is `cold` or `warm`; `mode` is `attended` or `batch`;
+    `task_tree_sha256` is 64 lowercase hex; `stop_rule` and `decision_rule`
+    are non-empty.
+    """
+    return RunRecord._load(path)
+
+
+def _attended_cap(record: RunRecord) -> None:
+    if record.n > 8:
+        raise RunRecordError(
+            f"attended runs cap at n=8, found {record.n}"
+        )
+    if record.max_minutes > 60:
+        raise RunRecordError(
+            f"attended runs cap at 60 minutes, found {record.max_minutes}"
+        )
+
+
+def _batch_cap(record: RunRecord) -> None:
+    if record.n > 12:
+        raise RunRecordError(
+            f"batch runs cap at n=12, found {record.n}"
+        )
+    if record.max_minutes > 720:
+        raise RunRecordError(
+            f"batch runs cap at 720 minutes, found {record.max_minutes}"
+        )
+
+
+def gate(record: RunRecord, *, previous_result_committed: bool | None) -> None:
+    """Enforce the cadence on an already loaded record.
+
+    Pure: no filesystem, no subprocess, no model. The caller computes whether
+    the referenced `previous_result` is committed and tells the gate; the
+    gate refuses when a `previous_result` is named but not committed. Raises
+    `RunRecordError` on any refusal.
+    """
+    match record.mode:
+        case "attended":
+            _attended_cap(record)
+        case "batch":
+            _batch_cap(record)
+        case _:
+            # Unreachable: `load_run_record` already refused a bad mode.
+            raise RunRecordError("mode must be attended or batch")
+    if record.previous_result is not None and not previous_result_committed:
+        raise RunRecordError(
+            f"previous_result {record.previous_result} is not committed"
+        )
