+def run_launch(record_path: str | None) -> int:
+    """`satyrn-evals launch --check RECORD`.
+
+    Without `--check`, `launch` is a placeholder for Phase 2's cell loop: it
+    prints the placeholder and returns the usage exit code. With `--check`,
+    the record is loaded and gated; a `RunRecordError` follows the CLI's
+    existing usage-error path (exit 2), a pass prints `launch: record
+    accepted` and returns 0.
+    """
+    if record_path is None:
+        print("launch: cells are Phase 2; use --check", file=sys.stderr)
+        return UsageError.exit_code
+    record = load_run_record(Path(record_path))
+    previous_result_committed: bool | None = None
+    if record.previous_result is not None:
+        completed = subprocess.run(
+            ["git", "ls-files", "--error-unmatch", record.previous_result],
+            capture_output=True,
+            check=False,
+        )
+        previous_result_committed = completed.returncode == 0
+    gate(record, previous_result_committed=previous_result_committed)
+    print("launch: record accepted")
+    return 0
+
+
