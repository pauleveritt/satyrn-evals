+def run_launch_check(path: Path) -> int:
+    """Gate a run record at ``path`` for Phase 1's `launch --check`.
+
+    Loads the record, computes whether its previous result is committed
+    (only when a previous result path is named), runs the gate, and prints
+    acceptance. Any `RunRecordError` follows the CLI's usage-error path.
+    """
+    try:
+        record = load_run_record(path)
+        committed = _previous_result_committed(record.previous_result)
+        gate(record, previous_result_committed=committed)
+    except RunRecordError as e:
+        print(f"satyrn-evals: {e}", file=sys.stderr)
+        return 2
+    print("launch: record accepted")
+    return 0
+
+
+def _previous_result_committed(previous_result: str | None) -> bool | None:
+    """Whether ``git ls-files --error-unmatch`` tracks ``previous_result``.
+
+    Returns `None` when no previous result path is named, so the default
+    tier never spawns a subprocess for a record without one.
+    """
+    if previous_result is None:
+        return None
+    proc = subprocess.run(
+        ["git", "ls-files", "--error-unmatch", str(previous_result)],
+        capture_output=True,
+    )
+    return proc.returncode == 0
+
