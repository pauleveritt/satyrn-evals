+"""The run record: the frozen description of one planned budgeted run.
+
+Phase 1 gates a record before any cell is launched. The record names the
+task, arm, model, condition, and budget, and the stopping and decision
+rules that bound the run. `load_run_record` refuses a record whose shape or
+types violate the contract; `gate` refuses a record whose cadence or the
+previous-result gate would be unsafe. Both raise `RunRecordError`, a
+`UsageError` (exit 2), so the CLI treats every refusal as a usage error and
+spends no budget.
+
+The contract is strict and ordered: the first missing or ill-typed field is
+named. Every refusal names the field or mode it concerns, and a record that
+could not be read or parsed names its path.
+"""
+
+import json
+from dataclasses import asdict, dataclass
+from pathlib import Path
+
+from satyrn_evals.errors import UsageError
+
+
+class RunRecordError(UsageError):
+    """A run record violates its contract, or the file could not be read."""
+
+
+#: Field order is the contract's canonical order. Every field is required
+#: except `previous_result`, which is a nullable path.
+_SCHEMA_FIELDS: tuple[str, ...] = (
+    "version",
+    "task",
+    "task_tree_sha256",
+    "arm",
+    "model",
+    "condition",
+    "n",
+    "mode",
+    "max_minutes",
+    "stop_rule",
+    "decision_rule",
+    "previous_result",
+)
+
+# Required fields, in schema order. `previous_result` is optional.
+_REQUIRED_FIELDS: tuple[str, ...] = _SCHEMA_FIELDS[:-1]
+
+_INT_FIELDS: frozenset[str] = frozenset({"version", "n", "max_minutes"})
+_STR_FIELDS: frozenset[str] = frozenset(
+    {"task", "task_tree_sha256", "arm", "model", "condition", "stop_rule", "decision_rule"}
+)
+
+_CONDITIONS = frozenset({"cold", "warm"})
+_MODES = frozenset({"attended", "batch"})
+
+_ATTENDED_MAX_CELLS = 8
+_ATTENDED_MAX_MINUTES = 60
+_BATCH_MAX_CELLS = 12
+_BATCH_MAX_MINUTES = 720
+
+
+def _hex_digest(value: object, length: int) -> bool:
+    if not isinstance(value, str) or len(value) != length:
+        return False
+    try:
+        int(value, 16)
+    except ValueError:
+        return False
+    return value == value.lower()
+
+
+@dataclass(frozen=True)
+class RunRecord:
+    """A frozen, validated description of one planned run."""
+
+    version: int
+    task: str
+    task_tree_sha256: str
+    arm: str
+    model: str
+    condition: str
+    n: int
+    mode: str
+    max_minutes: int
+    stop_rule: str
+    decision_rule: str
+    previous_result: str | None = None
+
+    def __post_init__(self) -> None:
+        # Type and value checks. Presence is guaranteed: `load_run_record`
+        # checks every required field before construction, so a missing
+        # field is reported there, in schema order, before this runs.
+        for name in _INT_FIELDS:
+            value = getattr(self, name)
+            if type(value) is not int:
+                raise RunRecordError(
+                    f"run record {name} has the wrong type "
+                    f"(expected int, found {type(value).__name__})"
+                )
+        for name in _STR_FIELDS:
+            value = getattr(self, name)
+            if type(value) is not str:
+                raise RunRecordError(
+                    f"run record {name} has the wrong type "
+                    f"(expected str, found {type(value).__name__})"
+                )
+        if "previous_result" in self.__dict__:
+            previous = self.previous_result
+            if previous is not None and type(previous) is not str:
+                raise RunRecordError(
+                    "run record previous_result has the wrong type "
+                    f"(expected null or str, found {type(previous).__name__})"
+                )
+
+        if self.condition not in _CONDITIONS:
+            raise RunRecordError(
+                f"condition must be cold or warm (got {self.condition!r})"
+            )
+        if self.mode not in _MODES:
+            raise RunRecordError(f"mode must be attended or batch (got {self.mode!r})")
+        if not _hex_digest(self.task_tree_sha256, 64):
+            raise RunRecordError(
+                "task_tree_sha256 is not a 64-character lowercase hex digest "
+                f"(got {self.task_tree_sha256!r})"
+            )
+        for name in ("stop_rule", "decision_rule"):
+            value = getattr(self, name)
+            if not value or not value.strip():
+                raise RunRecordError(f"{name} is empty")
+
+    def to_dict(self) -> dict[str, object]:
+        return asdict(self)
+
+
+def _check_presence_and_type(data: dict[str, object]) -> None:
+    """Check presence and type of every field in schema order.
+
+    Raises `RunRecordError` naming the first missing or ill-typed field.
+    """
+    for name in _REQUIRED_FIELDS:
+        if name not in data:
+            raise RunRecordError(f"run record missing field: {name}")
+        value = data[name]
+        if name in _INT_FIELDS and type(value) is not int:
+            raise RunRecordError(
+                f"run record {name} has the wrong type "
+                f"(expected int, found {type(value).__name__})"
+            )
+        if name in _STR_FIELDS and type(value) is not str:
+            raise RunRecordError(
+                f"run record {name} has the wrong type "
+                f"(expected str, found {type(value).__name__})"
+            )
+    if "previous_result" in data:
+        previous = data["previous_result"]
+        if previous is not None and type(previous) is not str:
+            raise RunRecordError(
+                "run record previous_result has the wrong type "
+                f"(expected null or str, found {type(previous).__name__})"
+            )
+
+
+def _check_values(data: dict[str, object]) -> None:
+    """Check each field's value in schema order."""
+    if data["condition"] not in _CONDITIONS:
+        raise RunRecordError(
+            f"condition must be cold or warm (got {data['condition']!r})"
+        )
+    if data["mode"] not in _MODES:
+        raise RunRecordError(f"mode must be attended or batch (got {data['mode']!r})")
+    if not _hex_digest(data["task_tree_sha256"], 64):
+        raise RunRecordError(
+            "task_tree_sha256 is not a 64-character lowercase hex digest "
+            f"(got {data['task_tree_sha256']!r})"
+        )
+    for name in ("stop_rule", "decision_rule"):
+        value = data[name]
+        if not value or not value.strip():
+            raise RunRecordError(f"{name} is empty")
+
+
+def load_run_record(path: Path) -> RunRecord:
+    """Read and validate a run record at ``path``.
+
+    Raises `RunRecordError` on a read failure, malformed JSON, a non-object
+    payload, or any contract violation. The error names the file's path for
+    the read/parse failures and the first missing or ill-typed field for the
+    contract failures.
+    """
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError as e:
+        raise RunRecordError(f"cannot read run record {path}: {e}") from e
+    try:
+        data = json.loads(text)
+    except json.JSONDecodeError as e:
+        raise RunRecordError(f"cannot parse run record {path}: {e}") from e
+    if not isinstance(data, dict):
+        raise RunRecordError(f"run record {path} is not a JSON object")
+    _check_presence_and_type(data)
+    _check_values(data)
+    return RunRecord(**data)
+
+
+def gate(record: RunRecord, *, previous_result_committed: bool | None) -> None:
+    """Enforce the run's cadence and the previous-result gate.
+
+    Raises `RunRecordError` on any refusal. The cadence caps cells and
+    minutes per mode; when a previous result path is named, it must already
+    be committed.
+    """
+    if record.mode == "attended":
+        if record.n > _ATTENDED_MAX_CELLS:
+            raise RunRecordError(
+                f"attended records need n <= {_ATTENDED_MAX_CELLS} (got {record.n})"
+            )
+        if record.max_minutes > _ATTENDED_MAX_MINUTES:
+            raise RunRecordError(
+                f"attended records need max_minutes <= {_ATTENDED_MAX_MINUTES} "
+                f"(got {record.max_minutes})"
+            )
+    elif record.mode == "batch":
+        if record.n > _BATCH_MAX_CELLS:
+            raise RunRecordError(
+                f"batch records need n <= {_BATCH_MAX_CELLS} (got {record.n})"
+            )
+        if record.max_minutes > _BATCH_MAX_MINUTES:
+            raise RunRecordError(
+                f"batch records need max_minutes <= {_BATCH_MAX_MINUTES} "
+                f"(got {record.max_minutes})"
+            )
+    if record.previous_result is not None and not previous_result_committed:
+        raise RunRecordError(
+            "previous_result is present but previous_result_committed is not True"
+        )
