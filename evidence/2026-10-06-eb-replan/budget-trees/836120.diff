+"""The run record: a frozen gate input describing one planned batch of cells.
+
+A run record freezes the conditions under which a batch of cells may run --
+the task, the task tree it was captured from, the arm and model, the
+condition, the planned cell count and budget, and the stopping and decision
+rules. `load_run_record` enforces the record's data contract as it reads the
+file; `gate` enforces the cadence on an already-loaded record. Both raise
+`RunRecordError`, a `UsageError`, so a bad record costs the CLI's usage exit
+code (2) and preserves nothing.
+"""
+
+import json
+import re
+from dataclasses import dataclass
+from pathlib import Path
+
+from satyrn_evals.errors import UsageError
+
+_RUN_RECORD_VERSION = 1
+
+# Fields in the exact on-disk order the acceptance suite asserts. Every field
+# is required; `previous_result` is the only one that may be null.
+_FIELD_NAMES: tuple[str, ...] = (
+    "version",
+    "task",
+    "task_tree_sha256",
+    "arm",
+    "model",
+    "condition",
+    "n",
+    "mode",
+    "max_minutes",
+    "stop_rule",
+    "decision_rule",
+    "previous_result",
+)
+
+_INT_FIELDS: frozenset[str] = frozenset({"version", "n", "max_minutes"})
+_VALID_CONDITIONS: frozenset[str] = frozenset({"cold", "warm"})
+_VALID_MODES: frozenset[str] = frozenset({"attended", "batch"})
+
+#: A task_tree_sha256 is 64 lowercase hex digits.
+_DIGEST_RE = re.compile(r"^[0-9a-f]{64}$")
+
+
+class RunRecordError(UsageError):
+    """A run record violates its data or cadence contract (usage exit 2).
+
+    The message names the first missing or ill-typed field, the offending
+    mode or rule, or the file that could not be read or parsed.
+    """
+
+
+@dataclass(frozen=True, slots=True)
+class RunRecord:
+    """The frozen, validated description of one planned batch of cells."""
+
+    version: int
+    task: str
+    task_tree_sha256: str
+    arm: str
+    model: str
+    condition: str
+    n: int
+    mode: str
+    max_minutes: int
+    stop_rule: str
+    decision_rule: str
+    previous_result: str | None
+
+
+def _is_int(value: object) -> bool:
+    # ``type() is int`` rejects ``bool``: JSON ``true`` is not an integer.
+    return type(value) is int
+
+
+def _type_ok(name: str, value: object) -> bool:
+    if name == "previous_result":
+        return value is None or isinstance(value, str)
+    if name in _INT_FIELDS:
+        return _is_int(value)
+    return isinstance(value, str)
+
+
+def load_run_record(path: Path) -> RunRecord:
+    """Read and validate a run record, raising `RunRecordError` on refusal.
+
+    The refusal names the file when it cannot be read or parsed, the first
+    missing or ill-typed field when the shape is right but a value is not,
+    and the offending mode or rule once the record is well-typed.
+    """
+    try:
+        text = path.read_text(encoding="utf-8")
+    except (OSError, UnicodeDecodeError) as exc:
+        raise RunRecordError(f"cannot read run record {path}: {exc}") from exc
+    try:
+        data = json.loads(text)
+    except json.JSONDecodeError as exc:
+        raise RunRecordError(f"run record {path} is not valid JSON: {exc}") from exc
+    if not isinstance(data, dict):
+        raise RunRecordError(f"run record {path} is not a JSON object")
+
+    typed: dict[str, object] = {}
+    for name in _FIELD_NAMES:
+        if name not in data:
+            raise RunRecordError(f"{name} is missing")
+        value = data[name]
+        if not _type_ok(name, value):
+            raise RunRecordError(f"{name} has the wrong type")
+        typed[name] = value
+
+    mode = typed["mode"]
+    if mode not in _VALID_MODES:
+        raise RunRecordError("mode must be attended or batch")
+
+    condition = typed["condition"]
+    if condition not in _VALID_CONDITIONS:
+        raise RunRecordError("condition must be cold or warm")
+
+    digest = typed["task_tree_sha256"]
+    if not _DIGEST_RE.match(digest):
+        raise RunRecordError("task_tree_sha256 must be 64 lowercase hex digits")
+
+    for name in ("stop_rule", "decision_rule"):
+        value = typed[name]
+        if not value or not value.strip():
+            raise RunRecordError(f"{name} is empty")
+
+    return RunRecord(
+        version=typed["version"],
+        task=typed["task"],
+        task_tree_sha256=typed["task_tree_sha256"],
+        arm=typed["arm"],
+        model=typed["model"],
+        condition=typed["condition"],
+        n=typed["n"],
+        mode=typed["mode"],
+        max_minutes=typed["max_minutes"],
+        stop_rule=typed["stop_rule"],
+        decision_rule=typed["decision_rule"],
+        previous_result=typed["previous_result"],
+    )
+
+
+def gate(record: RunRecord, *, previous_result_committed: bool | None) -> None:
+    """Enforce the cadence on an already-loaded record.
+
+    `attended` runs cap at 8 cells and 60 minutes; `batch` runs cap at 12
+    cells and 720 minutes. When `previous_result` names a path, that result
+    must already be committed. Any refusal raises `RunRecordError`.
+    """
+    if record.mode == "attended":
+        if record.n > 8:
+            raise RunRecordError(
+                f"attended run may not exceed 8 cells (n={record.n})"
+            )
+        if record.max_minutes > 60:
+            raise RunRecordError(
+                f"attended run may not exceed 60 minutes "
+                f"(max_minutes={record.max_minutes})"
+            )
+    else:
+        # `batch`: the only other validated mode.
+        if record.n > 12:
+            raise RunRecordError(
+                f"batch run may not exceed 12 cells (n={record.n})"
+            )
+        if record.max_minutes > 720:
+            raise RunRecordError(
+                f"batch run may not exceed 720 minutes "
+                f"(max_minutes={record.max_minutes})"
+            )
+    if record.previous_result is not None and not previous_result_committed:
+        raise RunRecordError("previous_result is not committed")
