+def _result_committed(path: Path) -> bool:
+    """True when ``path`` is tracked in the working tree (git-committed).
+
+    Git runs in the result's own directory so a path that lives in a nested
+    repo is checked against the repo that contains it.
+    """
+    result = subprocess.run(
+        ["git", "ls-files", "--error-unmatch", str(path)],
+        capture_output=True,
+        text=True,
+        cwd=Path(path).parent,
+    )
+    return result.returncode == 0
+
+
+def launch(record_path: str) -> int:
+    """Load and gate a run record, then accept it.
+
+    ``previous_result_committed`` is computed by `git ls-files --error-unmatch`
+    only when the record names a previous result; a null `previous_result`
+    commits nothing and spawns no process. On pass the record is accepted; a
+    `RunRecordError` follows the CLI's usage-error path (exit 2).
+    """
+    record = load_run_record(Path(record_path))
+    committed = record.previous_result is None or _result_committed(
+        Path(record.previous_result)
+    )
+    gate(record, previous_result_committed=committed)
+    print("launch: record accepted")
+    return 0
+
+
