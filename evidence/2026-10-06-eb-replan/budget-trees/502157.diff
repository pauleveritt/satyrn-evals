+"""The run-record gate.
+
+A run record freezes the task, prompt, model, engine, and stopping-rule
+conditions before a budgeted batch runs. ``load_run_record`` reads a record
+file and enforces its data contract; ``gate`` then enforces the cadence --
+cells and minutes per mode, plus the previous-result commit rule -- on an
+already-loaded record. Both raise ``RunRecordError``, a subclass of
+``UsageError`` (exit 2): a bad record is a usage error, not an operational
+one, so the fix is a corrected record, not a repaired machine.
+"""
+
+import json
+import re
+from dataclasses import dataclass
+from pathlib import Path
+
+from satyrn_evals.errors import UsageError
+
+#: A task tree digest: 64 lowercase hex digits.
+_HEX_RE = re.compile(r"[0-9a-f]{64}")
+
+#: (field name, expected type, may be null) in the exact order a record's
+#: fields are declared. Presence and type are checked in this order; value
+#: checks follow, also in this order -- so the first rule that breaks is the
+#: first one reported.
+_SCHEMA_FIELDS: tuple[tuple[str, type, bool], ...] = (
+    ("version", int, False),
+    ("task", str, False),
+    ("task_tree_sha256", str, False),
+    ("arm", str, False),
+    ("model", str, False),
+    ("condition", str, False),
+    ("n", int, False),
+    ("mode", str, False),
+    ("max_minutes", int, False),
+    ("stop_rule", str, False),
+    ("decision_rule", str, False),
+    ("previous_result", str, True),
+)
+
+
+class RunRecordError(UsageError):
+    """A run record violates its data contract (exit 2).
+
+    The message names the first missing or ill-typed field, or the rule it
+    breaks, so a refusal is a specific, reproducible usage error.
+    """
+
+
+def _is_int(value: object) -> bool:
+    # bool subclasses int; a JSON true/false is not a cell count.
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _is_str(value: object) -> bool:
+    return isinstance(value, str)
+
+
+@dataclass(frozen=True, slots=True)
+class RunRecord:
+    """A frozen run record: the contract recorded before a batch runs."""
+
+    version: int
+    task: str
+    task_tree_sha256: str
+    arm: str
+    model: str
+    condition: str
+    n: int
+    mode: str
+    max_minutes: int
+    stop_rule: str
+    decision_rule: str
+    previous_result: str | None
+
+
+def load_run_record(path: Path) -> RunRecord:
+    """Read a run record and enforce its data contract.
+
+    Raises ``RunRecordError`` on a file that cannot be read, JSON that does
+    not parse, JSON that is not an object, a missing or ill-typed field, a
+    bad condition, a bad mode, a bad digest, or an empty stopping rule.
+    """
+    try:
+        raw = path.read_text(encoding="utf-8")
+    except OSError as exc:
+        raise RunRecordError(f"cannot read run record {path}: {exc}") from exc
+    try:
+        data = json.loads(raw)
+    except json.JSONDecodeError as exc:
+        raise RunRecordError(f"cannot parse run record {path}: {exc}") from exc
+    if not isinstance(data, dict):
+        raise RunRecordError(f"run record {path} is not a JSON object")
+
+    values: dict[str, object] = {}
+    for name, expected, is_optional in _SCHEMA_FIELDS:
+        if name not in data:
+            raise RunRecordError(f"run record is missing required field: {name}")
+        value = data[name]
+        if is_optional:
+            if not (value is None or _is_str(value)):
+                raise RunRecordError(
+                    f"run record field {name} has the wrong type "
+                    f"(expected str, got {type(value).__name__})"
+                )
+        elif not (_is_int(value) if expected is int else _is_str(value)):
+            kind = "int" if expected is int else "str"
+            raise RunRecordError(
+                f"run record field {name} has the wrong type "
+                f"(expected {kind}, got {type(value).__name__})"
+            )
+        values[name] = value
+
+    condition = values["condition"]
+    if condition not in ("cold", "warm"):
+        raise RunRecordError("condition must be cold or warm")
+
+    mode = values["mode"]
+    if mode not in ("attended", "batch"):
+        raise RunRecordError("mode must be attended or batch")
+
+    if not _HEX_RE.fullmatch(values["task_tree_sha256"]):
+        raise RunRecordError("task_tree_sha256 must be 64 lowercase hex digits")
+
+    for name in ("stop_rule", "decision_rule"):
+        text = values[name]
+        if not text.strip():
+            raise RunRecordError(f"{name} is empty")
+
+    return RunRecord(
+        version=values["version"],
+        task=values["task"],
+        task_tree_sha256=values["task_tree_sha256"],
+        arm=values["arm"],
+        model=values["model"],
+        condition=condition,
+        n=values["n"],
+        mode=mode,
+        max_minutes=values["max_minutes"],
+        stop_rule=values["stop_rule"],
+        decision_rule=values["decision_rule"],
+        previous_result=values["previous_result"],
+    )
+
+
+def gate(record: RunRecord, *, previous_result_committed: bool | None) -> None:
+    """Enforce the cadence and the previous-result commit rule.
+
+    ``attended`` records allow at most 8 cells and 60 minutes; ``batch``
+    records allow at most 12 cells and 720 minutes. When ``previous_result``
+    is set, ``previous_result_committed`` must be True.
+    """
+    if record.mode == "attended":
+        if record.n > 8:
+            raise RunRecordError(
+                f"attended records may not exceed 8 cells; got {record.n}"
+            )
+        if record.max_minutes > 60:
+            raise RunRecordError(
+                f"attended records may not exceed 60 minutes; got {record.max_minutes}"
+            )
+    elif record.mode == "batch":
+        if record.n > 12:
+            raise RunRecordError(
+                f"batch records may not exceed 12 cells; got {record.n}"
+            )
+        if record.max_minutes > 720:
+            raise RunRecordError(
+                f"batch records may not exceed 720 minutes; got {record.max_minutes}"
+            )
+    if record.previous_result is not None and previous_result_committed is not True:
+        raise RunRecordError("previous_result is set but not committed")
