+def run_launch_check(record_path: str) -> int:
+    """Load and gate a run record. Returns 0 on accept, 2 on refusal.
+
+    A record whose ``previous_result`` names a path is only accepted once
+    that result is committed in the working tree; ``git ls-files --error-unmatch``
+    reports it. Any ``RunRecordError`` from loading or gating is a usage error
+    and follows the caller's existing usage-error path.
+    """
+    record = load_run_record(Path(record_path))
+    previous_result_committed = None
+    if record.previous_result is not None:
+        proc = subprocess.run(
+            [
+                "git",
+                "ls-files",
+                "--error-unmatch",
+                str(record.previous_result),
+            ],
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+        )
+        previous_result_committed = proc.returncode == 0
+    gate(record, previous_result_committed=previous_result_committed)
+    print("launch: record accepted")
+    return 0
+
+
 def main(argv: list[str] | None = None) -> int:
