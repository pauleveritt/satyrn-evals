@@ -0,0 +1,330 @@
+#!/usr/bin/env python3
+"""Measure oMLX decode speed against context size and stream concurrency.
+
+Instrument, not production code: it lives outside ``src/satyrn_evals`` and is
+covered by ``tests/test_speed_probe.py``. Phase 2b needs two numbers before a
+run record can fix them -- the context cap the server enforces, and the
+concurrency ``k`` at which throughput stops scaling -- and both come from a
+single sitting that is exclusive on the GPU.
+
+The tool is split so the expensive half never runs under test. ``run`` drives
+the live server and writes a plan: a POSIX-second window per context size and
+per concurrency level. ``analyze`` reads that plan beside the server log the
+same sitting produced and reports the decode rate per prompt, the total
+throughput per ``k``, and the chosen ``k``. No model, network, or subprocess is
+needed to check the arithmetic.
+
+oMLX writes one line per completion when it ends, e.g.::
+
+    2026-09-14 09:51:27,151 - omlx.server - INFO - [-] - Chat completion: \
+model=Ornith-1.5-9B-MLX-8bit, 758 tokens in 30.62s (27.3 tok/s), prompt: \
+44644, finish_reason=stop, max_tokens=32000, request_max_tokens=32000
+
+Usage::
+
+    scripts/speed_probe.py run --model M --plan plan.json \\
+        [--base-url URL] [--stream-seconds S] [--max-tokens N]
+    scripts/speed_probe.py analyze --plan plan.json --log server.log
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import statistics
+import sys
+import threading
+import time
+import urllib.request
+from collections.abc import Callable, Iterable, Sequence
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+CONTEXT_SIZES: tuple[int, ...] = (5000, 20000, 40000, 80000, 160000)
+CONCURRENCY: tuple[int, ...] = (1, 2, 3)
+K_THRESHOLD: float = 1.5
+SIZE_TOLERANCE: float = 0.25
+
+DEFAULT_BASE_URL = "http://localhost:8000"
+DEFAULT_STREAM_SECONDS = 30.0
+DEFAULT_MAX_TOKENS = 32000
+REQUEST_TIMEOUT = 600.0
+
+_STAMP = "%Y-%m-%d %H:%M:%S,%f"
+_LINE = re.compile(
+    r"^(?P<stamp>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d{1,6})\s+-\s+"
+    r"omlx\.server\s+-\s+INFO\s+.*?Chat completion: "
+    r"model=(?P<model>.+?), (?P<tokens>\d+) tokens in (?P<seconds>[\d.]+)s "
+    r"\((?P<rate>[\d.]+) tok/s\), prompt: (?P<prompt>\d+),"
+)
+
+_FILLER_TEXT = "the quick brown fox jumps over the lazy dog. "
+
+
+@dataclass(frozen=True)
+class Completion:
+    """One finished completion, as oMLX logs it when the request ends."""
+
+    ended: float
+    model: str
+    tokens: int
+    seconds: float
+    rate: float
+    prompt: int
+
+    @property
+    def started(self) -> float:
+        """POSIX timestamp the request began, ``ended`` less its duration."""
+        return self.ended - self.seconds
+
+
+def parse_line(line: str) -> Completion | None:
+    """Parse one oMLX server-log line, or ``None`` if it is not a completion.
+
+    Only an ``omlx.server - INFO`` line that carries a leading stamp and the
+    full ``Chat completion: model=..., N tokens in Xs (R tok/s), prompt: P,``
+    shape counts. Blank lines, other loggers, and a bare ``Chat completion:``
+    fragment without the stamp are all ``None``.
+    """
+    match = _LINE.match(line)
+    if match is None:
+        return None
+    return Completion(
+        ended=datetime.strptime(match["stamp"], _STAMP).timestamp(),
+        model=match["model"],
+        tokens=int(match["tokens"]),
+        seconds=float(match["seconds"]),
+        rate=float(match["rate"]),
+        prompt=int(match["prompt"]),
+    )
+
+
+def completions_in(
+    lines: Iterable[str], model: str, start: float, end: float
+) -> list[Completion]:
+    """Parsed completions of ``model`` whose ``ended`` lies in ``[start, end]``."""
+    kept: list[Completion] = []
+    for line in lines:
+        completion = parse_line(line)
+        if completion is None or completion.model != model:
+            continue
+        if start <= completion.ended <= end:
+            kept.append(completion)
+    return kept
+
+
+def nearest_size(prompt: int) -> int | None:
+    """The context size nearest ``prompt``, if within ``SIZE_TOLERANCE`` of it.
+
+    Ties go to the smaller size, so a prompt exactly between two sizes is
+    tested against the smaller one's tighter tolerance (``60000`` is ``None``).
+    """
+    size = min(CONTEXT_SIZES, key=lambda candidate: abs(candidate - prompt))
+    if abs(size - prompt) <= SIZE_TOLERANCE * size:
+        return size
+    return None
+
+
+def decode_by_size(completions: Sequence[Completion]) -> dict[int, float]:
+    """Median decode rate per nearest context size, keys ascending."""
+    rates: dict[int, list[float]] = {}
+    for completion in completions:
+        size = nearest_size(completion.prompt)
+        if size is not None:
+            rates.setdefault(size, []).append(completion.rate)
+    return {
+        size: statistics.median(rates[size]) for size in CONTEXT_SIZES if size in rates
+    }
+
+
+def total_throughput(completions: Sequence[Completion]) -> float:
+    """Tokens per second across a phase: all tokens over its wall-clock span."""
+    if not completions:
+        raise ValueError("no completions in this phase")
+    span = max(c.ended for c in completions) - min(c.started for c in completions)
+    return sum(c.tokens for c in completions) / span
+
+
+def choose_k(throughput: dict[int, float]) -> int:
+    """Largest ``k`` whose throughput reaches ``K_THRESHOLD`` times ``k = 1``.
+
+    ``k = 1`` is the baseline and always qualifies; a ``k`` absent from the
+    measured throughputs does not.
+    """
+    if 1 not in throughput:
+        raise ValueError("throughput has no k = 1 baseline")
+    best = 1
+    for k in CONCURRENCY:
+        if k in throughput and throughput[k] >= K_THRESHOLD * throughput[1]:
+            best = k
+    return best
+
+
+def analyze(plan: dict[str, Any], lines: Iterable[str]) -> dict[str, Any]:
+    """The report for one sitting: decode by prompt, throughput by ``k``, ``k``."""
+    model = plan["model"]
+    context: list[Completion] = []
+    for phase in plan["context"]:
+        context.extend(completions_in(lines, model, phase["start"], phase["end"]))
+    decode = decode_by_size(context)
+    throughput = {
+        phase["k"]: total_throughput(
+            completions_in(lines, model, phase["start"], phase["end"])
+        )
+        for phase in plan["concurrency"]
+    }
+    return {
+        "model": model,
+        "decode_tok_s_by_prompt": {
+            str(size): round(rate, 1) for size, rate in decode.items()
+        },
+        "missing_sizes": [size for size in CONTEXT_SIZES if size not in decode],
+        "total_tok_s_by_k": {
+            str(k): round(throughput[k], 1) for k in sorted(throughput)
+        },
+        "k": choose_k(throughput),
+    }
+
+
+def filler(tokens: int) -> str:
+    """Repeated English text of roughly four characters per requested token."""
+    repeats = (tokens * 4) // len(_FILLER_TEXT) + 1
+    return (_FILLER_TEXT * repeats)[: tokens * 4]
+
+
+def request(
+    base_url: str, model: str, tokens: int, max_tokens: int
+) -> urllib.request.Request:
+    """A POST to ``<base_url>/chat/completions`` whose body has exactly four keys."""
+    body = {
+        "model": model,
+        "messages": [{"role": "user", "content": filler(tokens)}],
+        "max_tokens": max_tokens,
+        "stream": False,
+    }
+    return urllib.request.Request(
+        f"{base_url.rstrip('/')}/chat/completions",
+        data=json.dumps(body).encode("utf-8"),
+        headers={"Content-Type": "application/json"},
+        method="POST",
+    )
+
+
+Opener = Callable[..., Any]
+
+
+def _send(
+    base_url: str, model: str, tokens: int, max_tokens: int, opener: Opener
+) -> None:
+    with opener(
+        request(base_url, model, tokens, max_tokens), timeout=REQUEST_TIMEOUT
+    ) as response:
+        response.read()
+
+
+def _stream(
+    base_url: str,
+    model: str,
+    tokens: int,
+    max_tokens: int,
+    deadline: float,
+    opener: Opener,
+) -> None:
+    while True:
+        _send(base_url, model, tokens, max_tokens, opener)
+        if time.time() >= deadline:
+            return
+
+
+def run(
+    base_url: str,
+    model: str,
+    *,
+    streams_seconds: float,
+    max_tokens: int,
+    opener: Opener,
+) -> dict[str, Any]:
+    """Drive the server and return the plan: context phases, then concurrency."""
+    context: list[dict[str, Any]] = []
+    for size in CONTEXT_SIZES:
+        start = time.time()
+        _send(base_url, model, size, max_tokens, opener)
+        context.append({"size": size, "start": start, "end": _after(start)})
+
+    concurrency: list[dict[str, Any]] = []
+    for k in CONCURRENCY:
+        start = time.time()
+        deadline = time.time() + streams_seconds
+        streams = [
+            threading.Thread(
+                target=_stream,
+                args=(base_url, model, CONTEXT_SIZES[-1], max_tokens, deadline, opener),
+            )
+            for _ in range(k)
+        ]
+        for stream in streams:
+            stream.start()
+        for stream in streams:
+            stream.join()
+        concurrency.append({"k": k, "start": start, "end": _after(start)})
+
+    return {
+        "model": model,
+        "base_url": base_url,
+        "context": context,
+        "concurrency": concurrency,
+    }
+
+
+def _after(start: float) -> float:
+    """A POSIX end stamp strictly after ``start``, even when the call is instant."""
+    end = time.time()
+    return end if end > start else start + 1e-6
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="speed_probe", description=__doc__)
+    subcommands = parser.add_subparsers(dest="command", required=True)
+
+    run_parser = subcommands.add_parser("run", help="drive the server, write a plan")
+    run_parser.add_argument("--model", required=True)
+    run_parser.add_argument("--plan", type=Path, required=True)
+    run_parser.add_argument("--base-url", default=DEFAULT_BASE_URL)
+    run_parser.add_argument(
+        "--stream-seconds", type=float, default=DEFAULT_STREAM_SECONDS
+    )
+    run_parser.add_argument("--max-tokens", type=int, default=DEFAULT_MAX_TOKENS)
+
+    analyze_parser = subcommands.add_parser("analyze", help="report a plan and log")
+    analyze_parser.add_argument("--plan", type=Path, required=True)
+    analyze_parser.add_argument("--log", type=Path, required=True)
+
+    args = parser.parse_args(argv)
+
+    if args.command == "run":
+        plan = run(
+            args.base_url,
+            args.model,
+            streams_seconds=args.stream_seconds,
+            max_tokens=args.max_tokens,
+            opener=urllib.request.urlopen,
+        )
+        args.plan.write_text(json.dumps(plan, indent=2) + "\n", encoding="utf-8")
+        return 0
+
+    try:
+        plan = json.loads(args.plan.read_text(encoding="utf-8"))
+        lines = args.log.read_text(encoding="utf-8").splitlines()
+        report = analyze(plan, lines)
+    except (OSError, ValueError, KeyError) as error:
+        print(f"speed_probe analyze: {error}", file=sys.stderr)
+        return 2
+    print(json.dumps(report))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
