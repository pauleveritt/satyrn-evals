index 0000000..08ccc9f
--- /dev/null
+++ b/tests/test_speed_probe.py
@@ -0,0 +1,370 @@
+"""The speed probe: log parsing, the arithmetic, and the live run's shape.
+
+The probe decides two numbers a run record later fixes -- the context cap and
+the concurrency ``k`` -- so both directions are checked here. A parser that
+matched any ``Chat completion:`` fragment would count another logger's line,
+and a ``choose_k`` that always returned the largest ``k`` would justify
+parallelism the server never delivered; each refusal test below has its
+sibling success.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+from datetime import datetime
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "scripts"))
+
+from speed_probe import (  # noqa: E402
+    CONCURRENCY,
+    CONTEXT_SIZES,
+    K_THRESHOLD,
+    SIZE_TOLERANCE,
+    Completion,
+    analyze,
+    choose_k,
+    completions_in,
+    decode_by_size,
+    filler,
+    main,
+    nearest_size,
+    parse_line,
+    request,
+    run,
+    total_throughput,
+)
+
+_LINE = (
+    "2026-09-14 09:51:27,151 - omlx.server - INFO - [-] - Chat completion: "
+    "model=Ornith-1.5-9B-MLX-8bit, 758 tokens in 30.62s (27.3 tok/s), "
+    "prompt: 44644, finish_reason=stop, max_tokens=32000, request_max_tokens=32000"
+)
+
+
+def _line(
+    ended: float,
+    *,
+    model: str = "m",
+    tokens: int = 100,
+    seconds: float = 10.0,
+    rate: float = 10.0,
+    prompt: int = 20000,
+) -> str:
+    stamp = datetime.fromtimestamp(ended).strftime("%Y-%m-%d %H:%M:%S,%f")
+    return (
+        f"{stamp} - omlx.server - INFO - [-] - Chat completion: model={model}, "
+        f"{tokens} tokens in {seconds}s ({rate} tok/s), prompt: {prompt}, "
+        "finish_reason=stop, max_tokens=32000, request_max_tokens=32000"
+    )
+
+
+def test_constants_are_the_measured_grid() -> None:
+    assert CONTEXT_SIZES == (5000, 20000, 40000, 80000, 160000)
+    assert CONCURRENCY == (1, 2, 3)
+    assert K_THRESHOLD == 1.5
+    assert SIZE_TOLERANCE == 0.25
+
+
+def test_parse_line_reads_the_full_completion() -> None:
+    completion = parse_line(_LINE)
+
+    assert completion is not None
+    assert completion.model == "Ornith-1.5-9B-MLX-8bit"
+    assert completion.tokens == 758
+    assert completion.seconds == 30.62
+    assert completion.rate == 27.3
+    assert completion.prompt == 44644
+    expected = datetime.strptime("2026-09-14 09:51:27,151", "%Y-%m-%d %H:%M:%S,%f")
+    assert completion.ended == expected.timestamp()
+    assert completion.started == completion.ended - 30.62
+
+
+def test_parse_line_refuses_a_blank_line() -> None:
+    assert parse_line("") is None
+
+
+def test_parse_line_refuses_another_logger() -> None:
+    line = _LINE.replace("omlx.server - INFO", "uvicorn - INFO")
+    assert parse_line(line) is None
+
+
+def test_parse_line_refuses_a_bare_chat_completion_fragment() -> None:
+    fragment = _LINE.split(" - [-] - ", 1)[1]
+    assert parse_line(fragment) is None
+
+
+def test_completions_in_keeps_only_this_model_inside_the_window() -> None:
+    base = datetime(2026, 9, 14, 12, 0, 0).timestamp()
+    lines = [
+        _line(base + 10, model="m"),
+        _line(base + 10, model="other"),
+        _line(base - 1, model="m"),
+        _line(base + 101, model="m"),
+    ]
+
+    kept = completions_in(lines, "m", base, base + 100)
+
+    assert len(kept) == 1
+    assert kept[0].model == "m"
+
+
+def test_completions_in_includes_both_ends() -> None:
+    base = datetime(2026, 9, 14, 12, 0, 0).timestamp()
+    lines = [_line(base), _line(base + 100)]
+
+    assert len(completions_in(lines, "m", base, base + 100)) == 2
+
+
+def test_nearest_size_rounds_to_the_measured_grid() -> None:
+    assert nearest_size(21000) == 20000
+    assert nearest_size(121600) == 160000
+    assert nearest_size(5000) == 5000
+
+
+def test_nearest_size_refuses_a_prompt_between_sizes() -> None:
+    assert nearest_size(60000) is None
+    assert nearest_size(0) is None
+
+
+def test_decode_by_size_takes_the_median_and_orders_the_keys() -> None:
+    completions = [
+        Completion(
+            ended=1.0, model="m", tokens=1, seconds=1.0, rate=20.0, prompt=21000
+        ),
+        Completion(
+            ended=2.0, model="m", tokens=1, seconds=1.0, rate=30.0, prompt=19000
+        ),
+        Completion(ended=3.0, model="m", tokens=1, seconds=1.0, rate=40.0, prompt=5000),
+    ]
+
+    assert decode_by_size(completions) == {5000: 40.0, 20000: 25.0}
+
+
+def test_decode_by_size_skips_prompts_off_the_grid() -> None:
+    completions = [
+        Completion(ended=1.0, model="m", tokens=1, seconds=1.0, rate=20.0, prompt=60000)
+    ]
+
+    assert decode_by_size(completions) == {}
+
+
+def test_total_throughput_is_tokens_over_the_wall_clock_span() -> None:
+    completions = [
+        Completion(
+            ended=100.0, model="m", tokens=100, seconds=10.0, rate=1.0, prompt=5000
+        ),
+        Completion(
+            ended=110.0, model="m", tokens=100, seconds=10.0, rate=1.0, prompt=5000
+        ),
+    ]
+
+    assert total_throughput(completions) == pytest.approx(200 / 20)
+
+
+def test_total_throughput_refuses_an_empty_phase() -> None:
+    with pytest.raises(ValueError, match="no completions"):
+        total_throughput([])
+
+
+def test_choose_k_takes_the_largest_that_scales() -> None:
+    assert choose_k({1: 10.0, 2: 15.0, 3: 20.0}) == 3
+    assert choose_k({1: 10.0, 2: 14.9, 3: 15.0}) == 3
+
+
+def test_choose_k_keeps_one_when_no_larger_k_scales() -> None:
+    assert choose_k({1: 10.0, 2: 10.0, 3: 10.0}) == 1
+    assert choose_k({1: 10.0}) == 1
+
+
+def test_choose_k_ignores_a_missing_k() -> None:
+    assert choose_k({1: 10.0, 3: 20.0}) == 3
+    assert choose_k({1: 10.0, 2: 20.0}) == 2
+
+
+def test_choose_k_refuses_without_a_baseline() -> None:
+    with pytest.raises(ValueError, match="k = 1"):
+        choose_k({2: 20.0, 3: 30.0})
+
+
+def test_filler_is_about_four_characters_per_token_and_never_more() -> None:
+    assert len(filler(100)) == 400
+    assert len(filler(0)) == 0
+    assert len(filler(999)) <= 999 * 4
+
+
+def test_request_posts_exactly_the_four_keys() -> None:
+    req = request("http://server", "m", 100, 8)
+
+    body = json.loads(req.data)
+    assert set(body) == {"model", "messages", "max_tokens", "stream"}
+    assert body["model"] == "m"
+    assert body["max_tokens"] == 8
+    assert body["stream"] is False
+    assert req.full_url == "http://server/chat/completions"
+    assert req.get_method() == "POST"
+
+
+def test_analyze_reports_decode_missing_throughput_and_k() -> None:
+    base = datetime(2026, 9, 14, 12, 0, 0).timestamp()
+    plan = {
+        "model": "m",
+        "base_url": "http://server",
+        "context": [{"size": 20000, "start": base, "end": base + 100}],
+        "concurrency": [{"k": 1, "start": base, "end": base + 100}],
+    }
+    lines = [_line(base + 10, tokens=500, seconds=5.0, rate=25.0, prompt=20000)]
+
+    report = analyze(plan, lines)
+
+    assert report["model"] == "m"
+    assert report["decode_tok_s_by_prompt"] == {"20000": 25.0}
+    assert report["missing_sizes"] == [5000, 40000, 80000, 160000]
+    assert report["total_tok_s_by_k"] == {"1": 100.0}
+    assert report["k"] == 1
+
+
+def test_analyze_chooses_the_scaling_k() -> None:
+    base = datetime(2026, 9, 14, 12, 0, 0).timestamp()
+    plan = {
+        "model": "m",
+        "base_url": "http://server",
+        "context": [{"size": 20000, "start": base, "end": base + 100}],
+        "concurrency": [
+            {"k": 1, "start": base, "end": base + 100},
+            {"k": 2, "start": base + 200, "end": base + 300},
+        ],
+    }
+    lines = [
+        _line(base + 10, tokens=100, seconds=1.0, rate=10.0, prompt=20000),
+        _line(base + 210, tokens=200, seconds=1.0, rate=10.0, prompt=20000),
+    ]
+
+    report = analyze(plan, lines)
+
+    assert report["total_tok_s_by_k"] == {"1": 100.0, "2": 200.0}
+    assert report["k"] == 2
+
+
+def test_main_analyze_prints_the_report(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    base = datetime(2026, 9, 14, 12, 0, 0).timestamp()
+    plan = {
+        "model": "m",
+        "base_url": "http://server",
+        "context": [{"size": 20000, "start": base, "end": base + 100}],
+        "concurrency": [{"k": 1, "start": base, "end": base + 100}],
+    }
+    plan_path = tmp_path / "plan.json"
+    plan_path.write_text(json.dumps(plan), encoding="utf-8")
+    log_path = tmp_path / "server.log"
+    log_path.write_text(_line(base + 10, prompt=20000) + "\n", encoding="utf-8")
+
+    status = main(["analyze", "--plan", str(plan_path), "--log", str(log_path)])
+
+    assert status == 0
+    assert json.loads(capsys.readouterr().out)["model"] == "m"
+
