+class _Response:
+    def __init__(self) -> None:
+        self.reads = 0
+
+    def __enter__(self) -> _Response:
+        return self
+
+    def __exit__(self, *exc: object) -> bool:
+        return False
+
+    def read(self) -> bytes:
+        self.reads += 1
+        return b"{}"
+
+
+class _Recorder:
+    def __init__(self) -> None:
+        self.calls: list[object] = []
+
+    def __call__(self, req: object, timeout: float | None = None) -> _Response:
+        self.calls.append(req)
+        return _Response()
+
+
+def test_run_sends_one_request_per_size_then_k_streams() -> None:
+    recorder = _Recorder()
+
+    plan = run(
+        "http://server",
+        "m",
+        streams_seconds=0.0,
+        max_tokens=8,
+        opener=recorder,
+    )
+
+    assert [phase["size"] for phase in plan["context"]] == list(CONTEXT_SIZES)
+    assert [phase["k"] for phase in plan["concurrency"]] == list(CONCURRENCY)
+    # One context request per size, then one per stream for each k.
+    assert len(recorder.calls) == len(CONTEXT_SIZES) + sum(CONCURRENCY)
+
+
+def test_run_records_phases_that_end_after_they_start() -> None:
+    recorder = _Recorder()
+
+    plan = run(
+        "http://server",
+        "m",
+        streams_seconds=0.0,
+        max_tokens=8,
+        opener=recorder,
+    )
+
+    for phase in plan["context"] + plan["concurrency"]:
+        assert phase["end"] > phase["start"]
+
+
+def test_run_builds_the_plan_the_analyzer_reads() -> None:
+    recorder = _Recorder()
+
+    plan = run(
+        "http://server",
+        "m",
+        streams_seconds=0.0,
+        max_tokens=8,
+        opener=recorder,
+    )
+
+    assert plan["model"] == "m"
+    assert plan["base_url"] == "http://server"
+    assert set(plan) == {"model", "base_url", "context", "concurrency"}
