vars: {
  d2-config: { sketch: true }
}
direction: right

"Developer's task": {
  style: {
    fill: "#fffdf5"
    font-color: "#2b2b2b"
    stroke: "#7a6a4a"
    stroke-width: 1
    border-radius: 8
  }
}
"attempt command": {
  style: {
    fill: "#fffdf5"
    font-color: "#2b2b2b"
    stroke: "#7a6a4a"
    stroke-width: 1
    border-radius: 8
  }
  subtitle: {
    label: "agent loop, treated as opaque"
    style: {
      fill: "transparent"
      stroke: "transparent"
      stroke-width: 0
      font-color: "#2b2b2b"
    }
  }
}
"saved patch + transcript": {
  style: {
    fill: "#fffdf5"
    font-color: "#2b2b2b"
    stroke: "#7a6a4a"
    stroke-width: 1
    border-radius: 8
  }
}
"offline grade": {
  style: {
    fill: "#fffdf5"
    font-color: "#2b2b2b"
    stroke: "#7a6a4a"
    stroke-width: 1
    border-radius: 8
  }
}
"receipt": {
  style: {
    fill: "#fffdf5"
    font-color: "#2b2b2b"
    stroke: "#7a6a4a"
    stroke-width: 1
    border-radius: 8
  }
}

"Developer's task" -> "attempt command": ""
"attempt command" -> "saved patch + transcript": ""
"saved patch + transcript" -> "offline grade": ""
"offline grade" -> "receipt": ""
