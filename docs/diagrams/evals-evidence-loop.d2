vars: {
  d2-config: { sketch: true }
}
direction: right

"Developer's task": {
  style: {
    fill: "#fffdf5"
    font-color: "#2b2b2b"
    stroke: "#7a6a4a"
    stroke-width: 1
    border-radius: 8
  }
}
"coding agent": {
  style: {
    fill: "#fffdf5"
    font-color: "#2b2b2b"
    stroke: "#7a6a4a"
    stroke-width: 1
    border-radius: 8
  }
}
"saved patch + transcript": {
  style: {
    fill: "#fffdf5"
    font-color: "#2b2b2b"
    stroke: "#7a6a4a"
    stroke-width: 1
    border-radius: 8
  }
}
"offline grade": {
  style: {
    fill: "#fffdf5"
    font-color: "#2b2b2b"
    stroke: "#7a6a4a"
    stroke-width: 1
    border-radius: 8
  }
}
"receipt": {
  style: {
    fill: "#fffdf5"
    font-color: "#2b2b2b"
    stroke: "#7a6a4a"
    stroke-width: 1
    border-radius: 8
  }
}

"Developer's task" -> "coding agent": ""
"coding agent" -> "saved patch + transcript": ""
"saved patch + transcript" -> "offline grade": ""
"offline grade" -> "receipt": ""
