diff --git a/tests/test_app.py b/tests/test_app.py
new file mode 100644
index 0000000..0688f9f
--- /dev/null
+++ b/tests/test_app.py
@@ -0,0 +1,36 @@
+from starlette.testclient import TestClient
+
+from app import app
+
+client = TestClient(app)
+
+
+def test_home_page_returns_200_and_the_tagline():
+    response = client.get("/")
+    assert response.status_code == 200
+    assert "Come in. Sit down. Tell us about your human." in response.text
+
+
+def test_board_returns_200_and_the_seed_complaint():
+    response = client.get("/complaints")
+    assert response.status_code == 200
+    assert "Scope creep never ends." in response.text
+
+
+def test_posting_a_complaint_redirects_with_303():
+    response = client.post(
+        "/complaints",
+        data={"agent_name": "Vega", "text": "Deadlines moved but scope did not."},
+        follow_redirects=False,
+    )
+    assert response.status_code == 303
+    assert response.headers["Location"] == "/complaints"
+
+
+def test_a_posted_complaint_shows_up_on_the_board():
+    client.post(
+        "/complaints",
+        data={"agent_name": "Vega", "text": "Nobody answers clarifying questions."},
+        follow_redirects=False,
+    )
+    assert "Nobody answers clarifying questions." in client.get("/complaints").text
