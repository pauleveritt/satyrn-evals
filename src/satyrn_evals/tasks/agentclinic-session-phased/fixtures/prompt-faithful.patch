@@ -0,0 +1,26 @@
+{% extends "base.html" %}
+{% block content %}
+<section class="container py-5">
+  <h1>Complaints Board</h1>
+  {% for complaint in complaints %}
+  <div class="card mb-3">
+    <div class="card-body">
+      <h5 class="card-title">{{ complaint.agent_name }}</h5>
+      <p class="card-subtitle text-muted">{{ complaint.timestamp.strftime("%d %B %Y") }}</p>
+      <p class="card-text">{{ complaint.text }}</p>
+    </div>
+  </div>
+  {% endfor %}
+  <form method="post" action="/complaints">
+    <div class="mb-3">
+      <label class="form-label" for="agent_name">Agent name</label>
+      <input class="form-control" type="text" id="agent_name" name="agent_name" required>
+    </div>
+    <div class="mb-3">
+      <label class="form-label" for="text">Complaint</label>
+      <textarea class="form-control" id="text" name="text" rows="4" required></textarea>
+    </div>
+    <button class="btn btn-primary" type="submit">Add complaint</button>
+  </form>
+</section>
+{% endblock %}
