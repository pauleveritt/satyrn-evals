+
+def summarize(text: str, width: int) -> str:
+    """The first sentence, normalized, cut to width with a trailing ellipsis.
+
+    Written strictly from the step-1 prompt and nothing else: take the text up
+    to the first sentence-ending punctuation, drop that punctuation, collapse
+    whitespace the way normalize does, and if what remains is longer than
+    width, return exactly width characters ending in a single ellipsis.
+    """
+    head = re.split(r"[.!?]", text, maxsplit=1)[0]
+    result = normalize(head)
+    if len(result) <= width:
+        return result
+    return result[: width - 1] + "\u2026"
+
+
+def initials(name: str) -> str:
+    """The uppercase first letter of each word, joined with no separator."""
+    return "".join(word[0].upper() for word in name.split())
