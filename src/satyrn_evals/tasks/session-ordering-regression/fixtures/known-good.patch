+def summarize(text: str, width: int) -> str:
+    """First sentence, normalized, cut to width with an ellipsis when cut."""
+    ends = [i for i in (text.find(t) for t in ".!?") if i != -1]
+    sentence = normalize(text[: min(ends)] if ends else text)
+    if len(sentence) <= width:
+        return sentence
+    return sentence[: width - 1].rstrip() + "…"
+
