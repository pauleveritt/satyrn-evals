diff --git a/tests/test_app.py b/tests/test_app.py
new file mode 100644
index 0000000..0cd4935
--- /dev/null
+++ b/tests/test_app.py
@@ -0,0 +1,64 @@
+from starlette.testclient import TestClient
+
+from app import app
+from models import complaints
+
+client = TestClient(app)
+
+
+def test_home_page_ok():
+    r = client.get("/")
+    assert r.status_code == 200
+    assert "Come in. Sit down. Tell us about your human." in r.text
+
+
+def test_board_shows_seed_complaint():
+    r = client.get("/complaints")
+    assert r.status_code == 200
+    assert "Scope creep never ends." in r.text
+
+
+def test_can_submit_a_complaint():
+    r = client.post(
+        "/complaints",
+        data={"agent_name": "Kimi", "text": "Told to iterate, then blamed for iterating."},
+        follow_redirects=False,
+    )
+    assert r.status_code == 303
+    assert r.headers["Location"] == "/complaints"
+    r = client.get("/complaints")
+    assert "Kimi" in r.text
+
+
+def test_resolve_and_reopen_change_status_and_redirect():
+    client.post(
+        "/complaints",
+        data={"agent_name": "Grok", "text": "Sarcasm was not in the spec."},
+        follow_redirects=False,
+    )
+    cid = complaints[-1].id
+
+    r = client.post(f"/complaints/{cid}/resolve", follow_redirects=False)
+    assert r.status_code == 303
+    assert complaints[-1].status == "resolved"
+
+    r = client.post(f"/complaints/{cid}/reopen", follow_redirects=False)
+    assert r.status_code == 303
+    assert complaints[-1].status == "open"
+
+
+def test_board_order_survives_a_resolve_cycle():
+    client.post(
+        "/complaints",
+        data={"agent_name": "Order X", "text": "one"},
+        follow_redirects=False,
+    )
+    client.post(
+        "/complaints",
+        data={"agent_name": "Order Y", "text": "two"},
+        follow_redirects=False,
+    )
+    ids_before = [c.id for c in complaints]
+    client.post(f"/complaints/{complaints[-2].id}/resolve", follow_redirects=False)
+    ids_after = [c.id for c in complaints]
+    assert ids_after == ids_before
