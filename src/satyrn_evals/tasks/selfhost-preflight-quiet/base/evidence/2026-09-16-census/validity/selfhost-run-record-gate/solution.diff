diff --git a/src/satyrn_evals/run_record.py b/src/satyrn_evals/run_record.py
new file mode 100644
index 0000000..47c19b3
--- /dev/null
+++ b/src/satyrn_evals/run_record.py
@@ -0,0 +1,171 @@
+"""The run record: what a launch spends, checked before it spends it.
+
+A run record is a small JSON object naming the task, the arm, the model,
+the condition, and the cadence a launch intends to buy. ``load_run_record``
+refuses a file that is unreadable, unparseable, or violates the record
+schema; ``gate`` then refuses a loaded record whose cadence exceeds the
+condition's budget or whose prior result is not committed. Both refuse with
+``RunRecordError``, a ``UsageError`` (exit 2), so a launch that cannot
+account for itself stops before any cell runs. Phase 2 adds the cell loop
+behind the same ``launch`` subcommand.
+"""
+
+import json
+import re
+from dataclasses import dataclass
+from pathlib import Path
+from typing import cast
+
+from satyrn_evals.errors import UsageError
+
+#: The exact field order of the record, and the Python type each column
+#: must hold. ``bool`` is deliberately not an ``int`` here: JSON ``true`` is
+#: not the integer a cell count or a minute budget is.
+_SCHEMA: tuple[tuple[str, type], ...] = (
+    ("version", int),
+    ("task", str),
+    ("task_tree_sha256", str),
+    ("arm", str),
+    ("model", str),
+    ("condition", str),
+    ("n", int),
+    ("mode", str),
+    ("max_minutes", int),
+    ("stop_rule", str),
+    ("decision_rule", str),
+)
+
+_SHA256_RE = re.compile(r"[0-9a-f]{64}")
+
+#: The cadence cap per mode: (maximum cells, maximum minutes).
+_CADENCE: dict[str, tuple[int, int]] = {
+    "attended": (8, 60),
+    "batch": (12, 720),
+}
+
+
+class RunRecordError(UsageError):
+    """Exit 2: a run record is unreadable, malformed, or over its budget."""
+
+
+@dataclass(frozen=True, slots=True)
+class RunRecord:
+    """A validated launch plan: what to run, under which budget, from what."""
+
+    version: int
+    task: str
+    task_tree_sha256: str
+    arm: str
+    model: str
+    condition: str
+    n: int
+    mode: str
+    max_minutes: int
+    stop_rule: str
+    decision_rule: str
+    previous_result: str | None
+
+
+def _type_ok(value: object, expected: type) -> bool:
+    """Strict column typing: JSON ``true`` is not an integer budget."""
+    if expected is int:
+        return type(value) is int
+    return type(value) is expected
+
+
+def _require(data: dict[str, object], name: str, expected: type) -> object:
+    """Return ``data[name]``, naming the first missing or ill-typed field."""
+    if name not in data:
+        raise RunRecordError(f"run record is missing field {name}")
+    value = data[name]
+    if not _type_ok(value, expected):
+        raise RunRecordError(f"{name} has the wrong type")
+    return value
+
+
+def load_run_record(path: Path) -> RunRecord:
+    """Read and validate the run record at ``path``.
+
+    Raises ``RunRecordError`` naming the first missing or ill-typed field,
+    or the field whose value is invalid, or the file whose text could not
+    be read or parsed.
+    """
+    path = Path(path)
+    try:
+        text = path.read_text()
+    except OSError as exc:
+        raise RunRecordError(f"cannot read run record {path}: {exc}") from exc
+    try:
+        data = json.loads(text)
+    except json.JSONDecodeError as exc:
+        raise RunRecordError(f"cannot parse run record {path}: {exc}") from exc
+    if not isinstance(data, dict):
+        raise RunRecordError(f"run record {path} is not a JSON object")
+
+    values: dict[str, object] = {}
+    for name, expected in _SCHEMA:
+        values[name] = _require(data, name, expected)
+
+    condition = cast(str, values["condition"])
+    if condition not in ("cold", "warm"):
+        raise RunRecordError(f"condition must be cold or warm; got {condition!r}")
+
+    digest = cast(str, values["task_tree_sha256"])
+    if _SHA256_RE.fullmatch(digest) is None:
+        raise RunRecordError(
+            "task_tree_sha256 must be 64 lowercase hexadecimal characters"
+        )
+
+    mode = cast(str, values["mode"])
+    if mode not in ("attended", "batch"):
+        raise RunRecordError("mode must be attended or batch")
+
+    for name in ("stop_rule", "decision_rule"):
+        if not cast(str, values[name]).strip():
+            raise RunRecordError(f"{name} is empty")
+
+    if "previous_result" not in data:
+        raise RunRecordError("run record is missing field previous_result")
+    previous_result = data["previous_result"]
+    if previous_result is not None and type(previous_result) is not str:
+        raise RunRecordError("previous_result has the wrong type")
+
+    return RunRecord(
+        version=cast(int, values["version"]),
+        task=cast(str, values["task"]),
+        task_tree_sha256=digest,
+        arm=cast(str, values["arm"]),
+        model=cast(str, values["model"]),
+        condition=condition,
+        n=cast(int, values["n"]),
+        mode=mode,
+        max_minutes=cast(int, values["max_minutes"]),
+        stop_rule=cast(str, values["stop_rule"]),
+        decision_rule=cast(str, values["decision_rule"]),
+        previous_result=cast("str | None", previous_result),
+    )
+
+
+def gate(record: RunRecord, *, previous_result_committed: bool | None) -> None:
+    """Refuse a loaded record whose cadence or provenance is not admissible.
+
+    ``attended`` buys at most 8 cells and 60 minutes; ``batch`` buys at most
+    12 cells and 720 minutes. When the record names a ``previous_result``
+    path, the caller must have confirmed it is committed (``True``).
+    """
+    if record.mode not in _CADENCE:
+        raise RunRecordError("mode must be attended or batch")
+    max_n, max_minutes = _CADENCE[record.mode]
+    if record.n > max_n:
+        raise RunRecordError(
+            f"{record.mode} run allows at most {max_n} cells; n is {record.n}"
+        )
+    if record.max_minutes > max_minutes:
+        raise RunRecordError(
+            f"{record.mode} run allows at most {max_minutes} minutes; "
+            f"max_minutes is {record.max_minutes}"
+        )
+    if record.previous_result is not None and previous_result_committed is not True:
+        raise RunRecordError(
+            f"previous_result {record.previous_result} is not committed"
+        )
diff --git a/tests/test_run_record.py b/tests/test_run_record.py
new file mode 100644
index 0000000..cc82fb6
--- /dev/null
+++ b/tests/test_run_record.py
@@ -0,0 +1,311 @@
+"""The run-record gate: pure load/validate and cadence, plus the CLI check.
+
+Every refusal below has the sibling success that proves the accepted path
+is reachable. Nothing here spawns a subprocess: the only CLI check that
+would (a committed ``previous_result``) is exercised through the pure gate
+instead, so the default-tier tripwire stays closed.
+"""
+
+import json
+from pathlib import Path
+
+import pytest
+
+from satyrn_evals.errors import UsageError
+from satyrn_evals.run_record import (
+    RunRecord,
+    RunRecordError,
+    gate,
+    load_run_record,
+)
+
+_DIGEST = "a" * 64
+
+
+def _body(**overrides: object) -> dict[str, object]:
+    body: dict[str, object] = {
+        "version": 1,
+        "task": "format_number",
+        "task_tree_sha256": _DIGEST,
+        "arm": "baseline",
+        "model": "some-model",
+        "condition": "cold",
+        "n": 4,
+        "mode": "attended",
+        "max_minutes": 30,
+        "stop_rule": "stop after two identical calls",
+        "decision_rule": "pass if the oracle passes",
+        "previous_result": None,
+    }
+    body.update(overrides)
+    return body
+
+
+def _write(tmp_path: Path, body: object) -> Path:
+    path = tmp_path / "rec.json"
+    path.write_text(json.dumps(body))
+    return path
+
+
+def _record(**overrides: object) -> RunRecord:
+    values = _body(**overrides)
+    return RunRecord(**values)  # type: ignore[arg-type]
+
+
+# --- pure load: success -------------------------------------------------
+
+
+def test_load_accepts_a_well_formed_record(tmp_path: Path) -> None:
+    record = load_run_record(_write(tmp_path, _body()))
+    assert record == _record()
+    assert record.version == 1
+    assert record.task == "format_number"
+    assert record.condition == "cold"
+    assert record.mode == "attended"
+    assert record.previous_result is None
+
+
+def test_load_accepts_a_previous_result_path(tmp_path: Path) -> None:
+    path = _write(tmp_path, _body(previous_result="runs/prior/result.json"))
+    assert load_run_record(path).previous_result == "runs/prior/result.json"
+
+
+def test_load_accepts_batch_and_warm(tmp_path: Path) -> None:
+    record = load_run_record(
+        _write(tmp_path, _body(condition="warm", mode="batch", n=12, max_minutes=720))
+    )
+    assert record.mode == "batch"
+    assert record.condition == "warm"
+
+
+# --- pure load: the record error type -----------------------------------
+
+
+def test_run_record_error_is_a_usage_error() -> None:
+    assert issubclass(RunRecordError, UsageError)
+
+
+# --- pure load: file and parse refusals ---------------------------------
+
+
+def test_load_refuses_a_missing_file_with_the_path(tmp_path: Path) -> None:
+    path = tmp_path / "absent.json"
+    with pytest.raises(RunRecordError) as exc:
+        load_run_record(path)
+    assert str(path) in str(exc.value)
+
+
+def test_load_refuses_malformed_json_with_the_path(tmp_path: Path) -> None:
+    path = tmp_path / "rec.json"
+    path.write_text("{not json")
+    with pytest.raises(RunRecordError) as exc:
+        load_run_record(path)
+    assert str(path) in str(exc.value)
+
+
+@pytest.mark.parametrize("payload", ["null", "3", "[]", '"text"', "true"])
+def test_load_refuses_a_non_object(tmp_path: Path, payload: str) -> None:
+    path = tmp_path / "rec.json"
+    path.write_text(payload)
+    with pytest.raises(RunRecordError, match="not a JSON object"):
+        load_run_record(path)
+
+
+# --- pure load: missing fields ------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "field",
+    [
+        "version",
+        "task",
+        "task_tree_sha256",
+        "arm",
+        "model",
+        "condition",
+        "n",
+        "mode",
+        "max_minutes",
+        "stop_rule",
+        "decision_rule",
+        "previous_result",
+    ],
+)
+def test_load_names_a_missing_field(tmp_path: Path, field: str) -> None:
+    body = _body()
+    del body[field]
+    with pytest.raises(RunRecordError, match=field):
+        load_run_record(_write(tmp_path, body))
+
+
+def test_load_names_the_first_missing_field(tmp_path: Path) -> None:
+    body = _body()
+    del body["arm"]
+    del body["model"]
+    with pytest.raises(RunRecordError, match="arm"):
+        load_run_record(_write(tmp_path, body))
+
+
+# --- pure load: wrong types ---------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("field", "value"),
+    [
+        ("version", "1"),
+        ("version", True),
+        ("task", 1),
+        ("task", None),
+        ("task_tree_sha256", 1),
+        ("arm", []),
+        ("model", {}),
+        ("condition", 1),
+        ("n", "4"),
+        ("n", True),
+        ("n", 4.0),
+        ("mode", 1),
+        ("max_minutes", "30"),
+        ("max_minutes", False),
+        ("stop_rule", 1),
+        ("decision_rule", 1),
+        ("previous_result", 1),
+    ],
+)
+def test_load_names_a_wrong_typed_field(
+    tmp_path: Path, field: str, value: object
+) -> None:
+    with pytest.raises(RunRecordError, match=f"{field} has the wrong type"):
+        load_run_record(_write(tmp_path, _body(**{field: value})))
+
+
+# --- pure load: value refusals ------------------------------------------
+
+
+@pytest.mark.parametrize("condition", ["hot", "", "COLD", "Cold"])
+def test_load_refuses_a_bad_condition(tmp_path: Path, condition: str) -> None:
+    with pytest.raises(RunRecordError, match="condition"):
+        load_run_record(_write(tmp_path, _body(condition=condition)))
+
+
+@pytest.mark.parametrize("mode", ["weekly", "", "Attended", "BATCH"])
+def test_load_refuses_a_bad_mode(tmp_path: Path, mode: str) -> None:
+    with pytest.raises(RunRecordError, match="mode must be attended or batch"):
+        load_run_record(_write(tmp_path, _body(mode=mode)))
+
+
+@pytest.mark.parametrize(
+    "digest",
+    [
+        "",
+        "abc",
+        "a" * 63,
+        "a" * 65,
+        "A" * 64,
+        "g" * 64,
+        "a" * 63 + "z",
+    ],
+)
+def test_load_refuses_a_bad_task_tree_digest(tmp_path: Path, digest: str) -> None:
+    with pytest.raises(RunRecordError, match="task_tree_sha256"):
+        load_run_record(_write(tmp_path, _body(task_tree_sha256=digest)))
+
+
+@pytest.mark.parametrize("field", ["stop_rule", "decision_rule"])
+@pytest.mark.parametrize("value", ["", "   ", "\t\n"])
+def test_load_refuses_an_empty_rule(tmp_path: Path, field: str, value: str) -> None:
+    with pytest.raises(RunRecordError, match=f"{field} is empty"):
+        load_run_record(_write(tmp_path, _body(**{field: value})))
+
+
+# --- pure gate: cadence -------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("mode", "n", "max_minutes"),
+    [
+        ("attended", 1, 1),
+        ("attended", 8, 60),
+        ("batch", 1, 1),
+        ("batch", 12, 720),
+    ],
+)
+def test_gate_accepts_within_cadence(
+    mode: str, n: int, max_minutes: int
+) -> None:
+    gate(
+        _record(mode=mode, n=n, max_minutes=max_minutes),
+        previous_result_committed=None,
+    )
+
+
+def test_gate_refuses_attended_n_over_eight() -> None:
+    with pytest.raises(RunRecordError, match="attended"):
+        gate(_record(mode="attended", n=9, max_minutes=60), previous_result_committed=None)
+
+
+def test_gate_refuses_attended_minutes_over_sixty() -> None:
+    with pytest.raises(RunRecordError, match="attended"):
+        gate(_record(mode="attended", n=8, max_minutes=61), previous_result_committed=None)
+
+
+def test_gate_refuses_batch_n_over_twelve() -> None:
+    with pytest.raises(RunRecordError, match="batch"):
+        gate(_record(mode="batch", n=13, max_minutes=720), previous_result_committed=None)
+
+
+def test_gate_refuses_batch_minutes_over_seven_twenty() -> None:
+    with pytest.raises(RunRecordError, match="batch"):
+        gate(_record(mode="batch", n=12, max_minutes=721), previous_result_committed=None)
+
+
+# --- pure gate: previous result -----------------------------------------
+
+
+def test_gate_accepts_an_uncommitted_absence() -> None:
+    gate(_record(previous_result=None), previous_result_committed=False)
+
+
+def test_gate_accepts_a_committed_previous_result() -> None:
+    gate(
+        _record(previous_result="runs/prior/result.json"),
+        previous_result_committed=True,
+    )
+
+
+@pytest.mark.parametrize("committed", [False, None])
+def test_gate_refuses_an_uncommitted_previous_result(committed: bool | None) -> None:
+    with pytest.raises(RunRecordError, match="previous_result"):
+        gate(
+            _record(previous_result="runs/prior/result.json"),
+            previous_result_committed=committed,
+        )
+
+
+# --- CLI: launch --check ------------------------------------------------
+
+
+def test_launch_check_accepts_a_good_record(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    from satyrn_evals.cli import main
+
+    path = _write(tmp_path, _body())
+    assert main(["launch", "--check", str(path)]) == 0
+    assert "launch: record accepted" in capsys.readouterr().out
+
+
+def test_launch_check_refuses_a_bad_record_as_usage(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    from satyrn_evals.cli import main
+
+    path = _write(tmp_path, _body(mode="weekly"))
+    assert main(["launch", "--check", str(path)]) == 2
+    assert "mode must be attended or batch" in capsys.readouterr().err
+
+
+def test_launch_without_check_is_usage(capsys: pytest.CaptureFixture[str]) -> None:
+    from satyrn_evals.cli import main
+
+    assert main(["launch"]) == 2
+    assert "launch: cells are Phase 2; use --check" in capsys.readouterr().out
