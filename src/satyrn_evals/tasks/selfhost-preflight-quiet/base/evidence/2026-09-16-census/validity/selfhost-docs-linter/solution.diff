diff --git a/tests/test_doc_caps.py b/tests/test_doc_caps.py
new file mode 100644
index 0000000..b6b8d1a
--- /dev/null
+++ b/tests/test_doc_caps.py
@@ -0,0 +1,96 @@
+from pathlib import Path
+
+from tools.lint_docs import check
+
+
+def _tree(root: Path) -> Path:
+    (root / "docs" / "results").mkdir(parents=True)
+    (root / "docs" / "reviews").mkdir()
+    (root / "docs" / "results" / ".gitkeep").write_text("")
+    (root / "docs" / "reviews" / ".gitkeep").write_text("")
+    (root / "ROADMAP.md").write_text("# Roadmap\n")
+    return root
+
+
+def _lines(n: int) -> str:
+    return "".join(f"line {i}\n" for i in range(n))
+
+
+def test_clean_tree_returns_an_empty_list(tmp_path: Path) -> None:
+    root = _tree(tmp_path)
+    assert check(root) == []
+
+
+def test_roadmap_over_the_cap_is_named(tmp_path: Path) -> None:
+    root = _tree(tmp_path)
+    (root / "ROADMAP.md").write_text(_lines(151))
+    assert check(root) == ["ROADMAP.md: 151 lines > 150"]
+
+
+def test_result_page_over_the_cap_is_named(tmp_path: Path) -> None:
+    root = _tree(tmp_path)
+    (root / "docs" / "results" / "r.md").write_text(_lines(120) + "```\n")
+    assert check(root) == ["docs/results/r.md: 121 lines > 120"]
+
+
+def test_spec_over_the_cap_is_named(tmp_path: Path) -> None:
+    root = _tree(tmp_path)
+    specs = root / "docs" / "superpowers" / "specs"
+    specs.mkdir(parents=True)
+    (specs / "s.md").write_text(_lines(401))
+    assert check(root) == ["docs/superpowers/specs/s.md: 401 lines > 400"]
+
+
+def test_result_page_without_a_fenced_block_is_named(tmp_path: Path) -> None:
+    root = _tree(tmp_path)
+    (root / "docs" / "results" / "r.md").write_text("# Result\n\nNo command here.\n")
+    assert check(root) == ["docs/results/r.md: no fenced recompute block"]
+
+
+def test_indented_command_is_not_a_fenced_block(tmp_path: Path) -> None:
+    root = _tree(tmp_path)
+    (root / "docs" / "results" / "r.md").write_text("# Result\n\n    uv run x\n")
+    assert check(root) == ["docs/results/r.md: no fenced recompute block"]
+
+
+def test_a_backtick_fence_satisfies_the_block_rule(tmp_path: Path) -> None:
+    root = _tree(tmp_path)
+    (root / "docs" / "results" / "r.md").write_text("# Result\n\n```\nuv run x\n```\n")
+    assert check(root) == []
+
+
+def test_too_many_result_files_are_named(tmp_path: Path) -> None:
+    root = _tree(tmp_path)
+    for i in range(13):
+        (root / "docs" / "results" / f"r{i}.md").write_text("```\nuv run x\n```\n")
+    assert "docs/results: 13 result files > 12" in check(root)
+
+
+def test_unpermitted_directory_under_docs_is_named(tmp_path: Path) -> None:
+    root = _tree(tmp_path)
+    (root / "docs" / "current").mkdir()
+    assert check(root) == ["docs/current: directory not permitted under docs/"]
+
+
+def test_trailing_whitespace_and_blank_eof_are_ordered(tmp_path: Path) -> None:
+    root = _tree(tmp_path)
+    (root / "docs" / "lessons.md").write_text("one  \ntwo\n\n")
+    assert check(root) == [
+        "docs/lessons.md:1: trailing whitespace",
+        "docs/lessons.md: blank line at EOF",
+    ]
+
+
+def test_blank_line_at_eof_alone_is_named(tmp_path: Path) -> None:
+    root = _tree(tmp_path)
+    (root / "docs" / "lessons.md").write_text("one\n\n")
+    assert check(root) == ["docs/lessons.md: blank line at EOF"]
+
+
+def test_skip_list_is_decided_from_the_path_relative_to_root(tmp_path: Path) -> None:
+    root = tmp_path / "build" / "repo"
+    _tree(root)
+    (root / "docs" / "lessons.md").write_text("one  \n")
+    (root / "node_modules").mkdir()
+    (root / "node_modules" / "generated.md").write_text("two  \n\n")
+    assert check(root) == ["docs/lessons.md:1: trailing whitespace"]
diff --git a/tools/lint_docs.py b/tools/lint_docs.py
new file mode 100644
index 0000000..df854b6
--- /dev/null
+++ b/tools/lint_docs.py
@@ -0,0 +1,161 @@
+"""Lint the documentation tree against the release-one caps.
+
+`check(root)` walks the tree, relative to `root`, and returns one plain
+string per violation. `just lint-docs` runs this module; a non-empty list
+is a non-zero exit. No model, no network, no subprocess.
+
+The caps: `ROADMAP.md` at most 150 lines; a result page at most 120 lines
+with a fenced code block; at most 12 result files; a spec at most 400
+lines (plans are uncapped by design); only the known directories under
+`docs/`. Every markdown file must be free of trailing whitespace and
+must not end on a blank line.
+"""
+
+import sys
+from pathlib import Path
+
+ROADMAP_CAP = 150
+RESULT_CAP = 120
+RESULT_COUNT_CAP = 12
+SPEC_CAP = 400
+RESULT_FENCE = "```"
+PERMITTED_DOCS_DIRS = frozenset(
+    {
+        "superpowers",
+        "superpowers/specs",
+        "superpowers/plans",
+        "results",
+        "reviews",
+    }
+)
+# Build, cache, and vendor directories that hold generated files, never
+# hand-authored prose. Membership is decided from each path's parts
+# *relative to the tree root*: a checkout nested under a directory whose
+# name happens to match (e.g. `.../build/repo`) must lint as if it were
+# checked out at the top level.
+SKIP_PARTS = frozenset(
+    {
+        "__pycache__",
+        ".venv",
+        "venv",
+        "node_modules",
+        "_build",
+        "build",
+        "dist",
+        ".git",
+        ".pytest_cache",
+        ".ruff_cache",
+        ".mypy_cache",
+        ".tox",
+    }
+)
+
+
+def _relative(root: Path, path: Path) -> str:
+    return path.relative_to(root).as_posix()
+
+
+def _is_skipped(rel: Path) -> bool:
+    return any(part in SKIP_PARTS for part in rel.parts)
+
+
+def _markdown_files(root: Path) -> list[Path]:
+    files = []
+    for path in root.rglob("*.md"):
+        if path.is_file() and not _is_skipped(path.relative_to(root)):
+            files.append(path)
+    return sorted(files)
+
+
+def _lines(path: Path) -> list[str]:
+    return path.read_text().splitlines()
+
+
+def _whitespace_failures(root: Path) -> list[str]:
+    failures: list[str] = []
+    for path in _markdown_files(root):
+        rel = _relative(root, path)
+        lines = _lines(path)
+        failures.extend(
+            f"{rel}:{number}: trailing whitespace"
+            for number, line in enumerate(lines, 1)
+            if line != line.rstrip()
+        )
+        if lines and lines[-1] == "":
+            failures.append(f"{rel}: blank line at EOF")
+    return failures
+
+
+def _cap_failures(root: Path) -> list[str]:
+    failures: list[str] = []
+    roadmap = root / "ROADMAP.md"
+    if roadmap.is_file():
+        count = len(_lines(roadmap))
+        if count > ROADMAP_CAP:
+            failures.append(f"ROADMAP.md: {count} lines > {ROADMAP_CAP}")
+
+    specs = root / "docs" / "superpowers" / "specs"
+    if specs.is_dir():
+        for path in sorted(specs.glob("*.md")):
+            count = len(_lines(path))
+            if count > SPEC_CAP:
+                failures.append(f"{_relative(root, path)}: {count} lines > {SPEC_CAP}")
+
+    results = root / "docs" / "results"
+    if results.is_dir():
+        for path in sorted(results.glob("*.md")):
+            count = len(_lines(path))
+            if count > RESULT_CAP:
+                failures.append(f"{_relative(root, path)}: {count} lines > {RESULT_CAP}")
+    return failures
+
+
+def _directory_failures(root: Path) -> list[str]:
+    failures: list[str] = []
+    docs = root / "docs"
+    if not docs.is_dir():
+        return failures
+    for path in sorted(docs.rglob("*")):
+        if not path.is_dir():
+            continue
+        rel = path.relative_to(docs).as_posix()
+        if rel not in PERMITTED_DOCS_DIRS:
+            failures.append(f"docs/{rel}: directory not permitted under docs/")
+    return failures
+
+
+def _result_failures(root: Path) -> list[str]:
+    failures: list[str] = []
+    results = root / "docs" / "results"
+    if not results.is_dir():
+        return failures
+
+    for path in sorted(results.glob("*.md")):
+        if not any(line.startswith(RESULT_FENCE) for line in _lines(path)):
+            failures.append(f"{_relative(root, path)}: no fenced recompute block")
+
+    files = [path for path in results.iterdir() if path.is_file() and path.name != ".gitkeep"]
+    if len(files) > RESULT_COUNT_CAP:
+        failures.append(f"docs/results: {len(files)} result files > {RESULT_COUNT_CAP}")
+    return failures
+
+
+def check(root: Path) -> list[str]:
+    """Return one message per documentation violation under `root`."""
+    failures: list[str] = []
+    failures.extend(_whitespace_failures(root))
+    failures.extend(_cap_failures(root))
+    failures.extend(_directory_failures(root))
+    failures.extend(_result_failures(root))
+    return failures
+
+
+def main() -> int:
+    failures = check(Path.cwd())
+    for failure in failures:
+        print(failure)
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
