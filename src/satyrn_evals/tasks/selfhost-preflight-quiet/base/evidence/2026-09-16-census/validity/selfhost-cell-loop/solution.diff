+    outcome = launch_cells(
+        night=night,
+        arms=["engine"],
+        n=4,
+        k=2,
+        max_seconds=100.0,
+        cell_seconds=1.0,
+        spawn=spawn,
+        drift=_no_drift,
+        clock=Clock(),
+        sleep=lambda _: None,
+    )
+    assert live["peak"] == 2
+    assert outcome.status is Status.COMPLETE
+
