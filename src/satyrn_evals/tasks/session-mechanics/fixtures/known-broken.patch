+
+def slugify(text: str) -> str:
+    """Lowercase and join words with single dashes."""
+    return "-".join(text.strip().lower().split())
+
+
+def truncate(text: str, width: int) -> str:
+    """Wrong on purpose: no ellipsis marker."""
+    return text[:width]
+
+
+def pluralize(word: str) -> str:
+    """Wrong on purpose: plain s even after s."""
+    return word + "s"
